{%- liquid
  assign language_support_rtl = settings.language_support_rtl
  if settings.enable_rtl and language_support_rtl != blank
    assign language_support_rtl_list = language_support_rtl | split: ','
    if language_support_rtl_list contains localization.language.iso_code
      assign enable_rtl = true
    endif
  endif
-%}
<!doctype html>
<html
  lang="{{ request.locale.iso_code }}"
  {% if enable_rtl %}
    dir="rtl"
  {% endif %}
>
  <head>
    <meta name="google-site-verification" content="BxkXFi0an8I2KRU6XcD2jepSn9bPILy8jFuKnlLTLRM" />

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/{% if settings.favicon contains '.svg' %}svg+xml{% else %}png{% endif %}"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}
    {% render 'color-schemes' %}

    {% # Inline critical CSS for above-the-fold content %}
    {% render 'critical-css' %}

    {% # Load css for template %}
    {{ 'theme.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'custom.css' | asset_url | stylesheet_tag: preload: true }}


    {% render 'styles' %}
    {% render 'meta-tags' %}
    {% render 'fonts' %}
    {% render 'scripts' %}
    {% render 'css-nojs' %}
    {%- if enable_rtl -%}
      {{ 'rtl.css' | asset_url | stylesheet_tag: preload: true }}
    {%- endif -%}

    {{ content_for_header }}
  </head>
  <body
    {% unless settings.animations_enabled %}
      data-motion-disabled="true"
    {% endunless %}
    class="{{ template.name }} {% if template.suffix %}template-suffix-{{ template.suffix }} template--{{ template.suffix }} {% endif %}{% if settings.animations_enabled %}animations-enabled {% endif %}{% if settings.page_transitions_enabled %}page-transitions-enabled {% endif %}{% unless cart.empty? %}cart-has-items{% endunless %}"
  >
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}

    {% if settings.page_transitions_enabled %}
      <page-transition class="page-transition no-js-hidden">
        <span class="visually-hidden">{{ 'accessibility.loading' | t }}</span>
      </page-transition>
    {% endif %}

    {% sections 'header-group' %}
    <script src="{{ 'critical.js' | asset_url }}" type="module" fetchpriority="low"></script>
    <main
      id="MainContent"
      class="main-content overflow-x-clip overflow-y-clip flex-grow relative z-1"
      role="main"
    >
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    {% sections 'overlay-group' %}
    {%- if settings.enable_back_to_top_button -%}
      {% render 'back-to-top-button' %}
    {%- endif -%}
    {% render 'martilness-color-swatches' %}

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.accordion__summary--link').forEach((link) => {
          link.addEventListener('click', (event) => {
            const id = (link.getAttribute('href') || '').replace('#', '');
            const target = id ? document.getElementById(id) : null;
            if (!target) return;
            event.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
        });

        const targetText = 'Læs mere her om hvordan rødlysterapi virker';
        document.querySelectorAll('p').forEach(p => {
          if (p.textContent.includes(targetText) && !p.querySelector('a')) {
            const currentSection = p.closest('.shopify-section');
            if (currentSection && currentSection.nextElementSibling) {
              const nextSectionId = currentSection.nextElementSibling.id;
              if (nextSectionId) {
                 const parts = p.innerHTML.split(targetText);
                 p.innerHTML = parts[0] + '<a href="#' + nextSectionId + '" style="text-decoration: underline; text-underline-offset: 4px; font-weight: 600; cursor: pointer;">' + targetText + '</a>' + parts[1];
                 
                 const a = p.querySelector('a');
                 a.addEventListener('click', (e) => {
                   e.preventDefault();
                   currentSection.nextElementSibling.scrollIntoView({ behavior: 'smooth' });
                 });
              }
            }
          }
        });
        // Rewrite any legacy martilness.dk / WordPress links to the current Shopify domain
        function rewriteDomainLink(anchor) {
          const href = anchor.getAttribute('href');
          if (!href) return;
          if (href.includes('trustpilot.com') || href.startsWith('mailto:')) return;

          try {
            const url = new URL(href, window.location.origin);
            if (url.hostname === 'martilness.dk' || url.hostname === 'www.martilness.dk') {
              let newPath = url.pathname;
              if (newPath.startsWith('/produkt/')) {
                newPath = newPath.replace('/produkt/', '/products/');
              } else if (newPath.startsWith('/product/')) {
                newPath = newPath.replace('/product/', '/products/');
              } else if (newPath.startsWith('/vare/')) {
                newPath = newPath.replace('/vare/', '/products/');
              } else if (newPath.startsWith('/vare-kategori/')) {
                newPath = newPath.replace('/vare-kategori/', '/collections/');
              } else if (newPath.startsWith('/produkt-kategori/')) {
                newPath = newPath.replace('/produkt-kategori/', '/collections/');
              } else if (newPath === '/butik' || newPath === '/butik/' || newPath === '/shop' || newPath === '/shop/') {
                newPath = '/collections/all';
              } else if (newPath === '/om-os' || newPath === '/om-os/') {
                newPath = '/pages/om-martilness';
              } else if (newPath === '/kontakt' || newPath === '/kontakt/') {
                newPath = '/pages/contact';
              }
              anchor.setAttribute('href', window.location.origin + newPath + url.search + url.hash);
            }
          } catch (e) {}
        }

        document.querySelectorAll('a[href*="martilness.dk"]').forEach(rewriteDomainLink);

        document.addEventListener('click', (e) => {
          const anchor = e.target.closest('a[href*="martilness.dk"]');
          if (anchor) {
            rewriteDomainLink(anchor);
          }
        }, true);
      });
    </script>
  </body>
</html>