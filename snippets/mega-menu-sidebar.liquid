{%- liquid
  assign promotion_columns = block.settings.promotion_columns
-%}
{%- case block.settings.layout -%}
  {%- when 'with-banner' -%}
    {%- if block.settings.image != blank -%}
      <div class="mega-menu__promotions">
        {%- if block.settings.image != blank -%}
          <a
            class="mega-menu__banner-simple"
            href="{{ block.settings.button_link | default: '#' }}"
            style="display:block;border-radius:1.6rem;overflow:hidden;"
          >
            {{
              block.settings.image
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 900',
                sizes: '(min-width: 990px) 18vw, 45vw',
                alt: block.settings.heading | default: shop.name,
                style: 'width:100%;height:auto;display:block;'
            }}
            {%- if block.settings.heading != blank -%}
              <span style="display:block;padding:1rem 1.2rem 0;font-weight:650;">{{ block.settings.heading }}</span>
            {%- endif -%}
            {%- if block.settings.subheading != blank -%}
              <span style="display:block;padding:0.4rem 1.2rem 1.2rem;opacity:0.75;font-size:1.3rem;">{{ block.settings.subheading }}</span>
            {%- endif -%}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- when 'with-products' -%}
    {%- if block.settings.product_list != blank -%}
      <div class="mega-menu__promotions menu-sidebar__products">
        {%- liquid
          assign products_to_display = block.settings.product_list.count

          assign is_carousel = false
          if products_to_display > promotion_columns
            assign is_carousel = true
          endif
        -%}
        <carousel-slider
          class="carousel carousel--grid relative"
          style="{% render 'gap-style', column_gap: 10, column_gap_mobile: 10 %};--f-columns-xxl: {{ promotion_columns }};--f-columns-mobile: {{ promotion_columns }};"
        >
          <script type="application/json" ref="config">
            {
              "loop": false,
              "slidesPerView": {{ promotion_columns }},
              "spaceBetween": 10,
              "pagination": false,
              "counter": false,
              "navigationPosition": {
                "enabled": true,
                "selector": ".media img"
              }
            }
          </script>
          <div ref="container" class="swiper">
            <div class="swiper-wrapper">
              {%- for product in block.settings.product_list -%}
                <div class="swiper-slide">
                  {%- render 'product-card',
                    product: product,
                    show_vendor: block.settings.show_product_vendor,
                    show_type: block.settings.show_product_type,
                    show_badges: block.settings.show_product_badges
                  -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
          {%- if is_carousel -%}
            {% render 'carousel-controls',
              type: 'absolute',
              pagination: false,
              counter: false,
              navigation: true,
              navigation_inside: true,
              navigation_size: 'small'
            %}
          {%- endif -%}
        </carousel-slider>
      </div>
    {%- endif -%}
{%- endcase -%}
