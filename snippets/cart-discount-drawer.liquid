<dialog-component id="cart-discount-drawer" focus-target=".cart-discount__input">
  <button
    class="cart-drawer__addon-button custom-discount-link flex items-center gap-2 w-full text-left button-unstyled cursor-pointer"
    on:click="/showDialog"
    aria-haspopup="dialog"
    aria-controls="cart-discount-dialog"
    aria-label="{{ 'actions.discount_code' | t }}"
    style="font-size: 1.4rem; padding: 0.5rem 0; color: #2c3547;"
  >
    <div style="color: #2c3547; opacity: 0.9; margin-top: 2px;">
      {%- render 'icon', icon: 'tag', size: 'small' -%}
    </div>
    <span style="border-bottom: 1px solid rgba(44,53,71,0.3); padding-bottom: 1px; display: inline-block;">
      Tilføj rabatkode
    </span>
  </button>
  <dialog
    id="cart-discount-dialog"
    ref="dialog"
    class="cart-drawer__addon dialog dialog--drawer dialog--drawer-bottom dialog--drawer-bottom--right color-{{ color_scheme }}"
    scroll-lock
  >
    <div class="cart-drawer__addon-inner flex flex-col gap-4 xl:gap-5">
      <div class="cart-drawer__addon-header flex flex-row items-center justify-between">
        <p class="cart-drawer__addon-title h5">{{ 'actions.discount_code' | t }}</p>
        <button
          class="cart-drawer__close cart-drawer__close--addon dialog__close shrink-0"
          on:click="/closeDialog"
          aria-label="{{ 'accessibility.close_dialog' | t }}"
        >
          {% render 'icon', icon: 'close', size: 'large' %}
        </button>
      </div>
      <div class="cart-drawer__addon-content">
        {% render 'cart-discount', section_id: section_id %}
      </div>
    </div>
  </dialog>
</dialog-component>
