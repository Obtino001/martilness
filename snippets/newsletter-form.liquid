{%- doc -%}
  Renders newsletter form

  @param {string} [design] - Accetps: design-1, design-2
  @param {string} block_id - Unique id that append to form
  @param {string} [button_label] - Submit button label
  @param {string} [button_style] - Submit button style

  @example
  {% render 'newsletter-form', design: 'design-1' %}
{%- enddoc -%}
{%- liquid
  assign default_label = 'blocks.email_signup.label' | t
  assign default_button_label = 'actions.sign_up' | t
  assign button_label = button_label | default: default_button_label
  assign form_id = '-NewsletterForm' | prepend: block_id
  assign button_style = button_style | default: 'btn--primary'
  assign design = design | default: 'design-1'
  assign klaviyo_company_id = 'Uqmfz6'
  assign klaviyo_list_id = 'UatuwU'

  assign button_class = 'btn ' | append: button_style
  case design
    when 'design-1'
      assign button_class = button_class | append: ' btn--icon-only btn--small'
  endcase

-%}

<newsletter-form
  class="newsletter-form newsletter-form--{{ design }}"
  data-klaviyo-company-id="{{ klaviyo_company_id }}"
  data-klaviyo-list-id="{{ klaviyo_list_id }}"
  data-klaviyo-source="Martilness newsletter form"
>
  <form id="{{ form_id }}" onsubmit="return false;">
    <div class="newsletter-form__field relative flex flex-col gap-4 md:gap-5">
      <label class="visually-hidden" for="{{ form_id }}__input">
        {{ default_label }}
      </label>
      <input
        ref="input"
        id="{{ form_id }}__input"
        type="email"
        name="email"
        class="form-control w-full newsletter-form__input"
        aria-required="true"
        autocorrect="off"
        autocapitalize="off"
        autocomplete="email"
        placeholder="{{ 'blocks.email_signup.placeholder' | t }}"
        required
      >
      <button
        type="submit"
        name="commit"
        id="{{ form_id }}__submit"
        class="newsletter-form__button {{ button_class }}"
      >
        <span class="btn__text{% if design == 'design-1' %} visually-hidden{% endif %}">
          {{ button_label }}
        </span>
        {%- if design == 'design-1' -%}
          {% render 'icon', icon: 'caret-right', size: 'custom-size' %}
        {%- endif -%}
      </button>
    </div>
    <p
      class="alert alert--error w-full flex items-center gap-2 newsletter-form__inline-message hidden"
      data-klaviyo-newsletter-error
      id="{{ form_id }}__error"
      role="alert"
    >
      {% render 'icon', icon: 'warning' %}
      <span>{{- 'blocks.email_signup.error' | t -}}</span>
    </p>
    <p
      class="alert alert--success w-full flex items-center gap-2 newsletter-form__inline-message hidden"
      data-klaviyo-newsletter-success
      id="{{ form_id }}__success"
      role="status"
    >
      {% render 'icon', icon: 'bell-ringing' %}
      <span>{{- 'blocks.email_signup.success' | t -}}</span>
    </p>
  </form>
</newsletter-form>
