{%- liquid
  assign text_align = text_align | default: 'start'
  assign text_align_mobile = text_align_mobile | default: 'inherit'

  if text_align_mobile == 'inherit'
    assign text_align_mobile = text_align
  endif

  assign justify = text_align | replace: 'left', 'start' | replace: 'right', 'end'
  assign justify_mobile = text_align_mobile | replace: 'left', 'start' | replace: 'right', 'end'
-%}
<nav
  class="breadcrumbs flex items-center justify-{{ justify_mobile }} md:justify-{{ justify }} gap-x-3 text-body-sm"
  role="navigation"
  aria-label="breadcrumbs"
>
  {%- unless template contains 'product' -%}
  <a
    href="{{ routes.root_url }}"
    title="{{- 'content.home' | t -}}"
    class="reversed-link"
  >
    {{- 'content.home' | t -}}
  </a>
  {%- endunless -%}
  {%- if template contains 'page' -%}
    <span aria-hidden="true" class="breadcrumbs__sep"></span>
    <span class="breadcrumbs__last color-subtext text-ellipsis">{{ page.title }}</span>
  {%- elsif template contains 'product' -%}
    {%- liquid
      assign back_url = routes.all_products_collection_url
      assign primary_collection = product.metafields.breadcrumbs.primary_collection

      if primary_collection != blank and primary_collection.value.url != blank
        assign back_url = primary_collection.value.url
      elsif product.collections.first != blank
        assign back_url = product.collections.first.url
      endif
    -%}
    <a
      href="{{ back_url }}"
      class="reversed-link breadcrumbs__back"
      data-breadcrumb-back
    >
      <svg
        class="breadcrumbs__back-icon"
        width="16"
        height="16"
        viewBox="0 0 16 16"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M10.5 3.5 6 8l4.5 4.5"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      {{- 'content.back' | t -}}
    </a>
    <script>
      (() => {
        const link = document.querySelector('[data-breadcrumb-back]');
        if (!link) return;
        link.addEventListener('click', (event) => {
          try {
            if (!document.referrer) return;
            const from = new URL(document.referrer);
            if (from.origin !== window.location.origin) return;
            if (from.pathname === window.location.pathname) return;
            if (window.history.length < 2) return;
            event.preventDefault();
            window.history.back();
          } catch (e) {}
        });
      })();
    </script>
  {%- elsif template contains 'collection' and collection.handle -%}
    {%- if collection.handle != 'all' -%}
      <span aria-hidden="true" class="breadcrumbs__sep"></span>
      <a href="{{ routes.all_products_collection_url }}" class="reversed-link">
        {{- 'content.collection' | t -}}
      </a>
    {% endif %}
    <span aria-hidden="true" class="breadcrumbs__sep"></span>
    {%- if current_tags -%}
      {%- capture url -%}{{ routes.collections_url }}/{{ collection.handle }}{%- endcapture -%}
      {{ collection.title | link_to: url, class: 'reversed-link' }}
      <span aria-hidden="true" class="breadcrumbs__sep"></span>
      <span class="breadcrumbs__last color-subtext text-ellipsis">{{ current_tags | join: ' + ' }}</span>
    {%- else -%}
      <span class="breadcrumbs__last color-subtext text-ellipsis">{{ collection.title }}</span>
    {%- endif -%}
  {%- elsif template == 'list-collections' -%}
    <span aria-hidden="true" class="breadcrumbs__sep"></span>
    <span class="breadcrumbs__last color-subtext text-ellipsis">{{ 'content.collections' | t }}</span>
  {%- elsif template == 'blog' -%}
    <span aria-hidden="true" class="breadcrumbs__sep"></span>
    {%- if current_tags -%}
      {{ blog.title | link_to: blog.url, class: 'reversed-link' }}
      <span aria-hidden="true" class="breadcrumbs__sep"></span>
      <span class="breadcrumbs__last color-subtext text-ellipsis">{{ current_tags | join: ' + ' }}</span>
    {%- else -%}
      <span class="breadcrumbs__last color-subtext text-ellipsis">{{ blog.title }}</span>
    {%- endif -%}
  {%- elsif template == 'article' -%}
    <span aria-hidden="true" class="breadcrumbs__sep"></span>
    {{ blog.title | link_to: blog.url, class: 'reversed-link' }}
    <span aria-hidden="true" class="breadcrumbs__sep"></span>
    <span class="breadcrumbs__last color-subtext text-ellipsis">{{ article.title }}</span>
  {%- elsif template == 'cart' -%}
    <span aria-hidden="true" class="breadcrumbs__sep"></span>
    <span class="breadcrumbs__last color-subtext text-ellipsis">{{ 'content.cart' | t }}</span>
  {%- else -%}
    <span aria-hidden="true" class="breadcrumbs__sep"></span>
    <span class="breadcrumbs__last color-subtext text-ellipsis">{{ page_title }}</span>
  {%- endif -%}
</nav>
