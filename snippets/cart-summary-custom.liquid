{% comment %}
  cart-summary-custom.liquid  —  tilpasset udgave af cart-summary.liquid (drawer)

  Ændringer i forhold til standard cart-summary.liquid:
    1. Totaler vises som TO LINJER: "Rabat" (kun når der er en besparelse) + "Subtotal".
       (Den store "Anslået total" er erstattet af disse to linjer, gjort lidt større.)
    2. "Se kurv"-knappen er FJERNET — der er kun én checkout-knap.
    3. Checkout-knappen viser subtotalen i parentes efter teksten, fx
       "Gå til sikker betaling (162,00 kr)". Teksten styres af checkout_label nedenfor.
    4. Moms/policy-noten over knappen er fjernet.
    5. Egne betalingsikoner er tilføjet under knappen med minimal padding.
    6. Tag-ikonet (rabatkode) ligger på samme bånd som totalerne, så det ikke
       skubber Subtotal ned.

  SÅDAN TESTER/SKIFTER DU:
    Renderes fra snippets/cart-drawer-summary.liquid (sidste linje). Skift dér
    'cart-summary-custom' → 'cart-summary' for at gå tilbage til standarden.

  NOTER:
    - "Rabat" = summen pr. linje af (førpris/salgspris − betalt) × antal, altså
      samme besparelse som "Du sparer" på kurv-linjen. Fanger både førpris-udsalg
      og egentlige Shopify-rabatter. Skjules når der ingen besparelse er.
    - ref="cartTotal" + data-cart-subtotal MÅ blive stående: bruges af kurv-JS og
      Shopifys payment_terms. Totalen opdateres via fuld section-morph ved
      antalsændring, så både Subtotal og knap-subtotal holder sig korrekte.
{% endcomment %}

{% liquid
  assign context = context | default: 'drawer'
  assign class = 'cart-summary'
  assign class_inner = 'cart-summary__inner flex flex-col gap-2 xl:gap-3'
  assign class_addons = 'cart-summary__addons'

  # Label til rabat-linjen (skift her hvis du vil have en anden tekst)
  assign discount_label = 'Rabat'
  # Tekst på checkout-knappen (subtotal tilføjes automatisk efter)
  assign checkout_label = 'Gå til sikker betaling'
  assign subtotal_label = 'content.cart_subtotal' | t

  if context == 'drawer'
    assign class = class | append: ' cart-drawer-summary'
    assign class_inner = class_inner | append: ' cart-drawer-summary__inner color-' | append: section.settings.summary_color_scheme
    assign class_addons = class_addons | append: ' cart-drawer-summary__addons flex flex-wrap justify-end text-left'

    if section.settings.summary_show_seperator_line
      assign class_inner = class_inner | append: ' show-seperator-line'
    endif
  endif

  # Totalpris (respekterer indstillingen for valuta-kode)
  if settings.show_currency_code
    assign total_price = cart.total_price | money_with_currency
  else
    assign total_price = cart.total_price | money
  endif

  # Samlet besparelse ("Rabat") = sum af linjernes besparelse.
  # Referenceprisen pr. vare er compare-at (førpris) hvis den er højere end
  # salgsprisen, ellers salgsprisen. Så fanger vi BÅDE førpris-udsalg og
  # egentlige Shopify-rabatter. (Kurv-linjen viser "Du sparer" på samme grundlag.)
  assign savings_cents = 0
  for item in cart.items
    assign ref_price = item.original_price
    if item.variant.compare_at_price > item.original_price
      assign ref_price = item.variant.compare_at_price
    endif
    assign line_ref = ref_price | times: item.quantity
    assign line_savings = line_ref | minus: item.final_line_price
    if line_savings > 0
      assign savings_cents = savings_cents | plus: line_savings
    endif
  endfor

  if settings.show_currency_code
    assign discount_display = savings_cents | money_with_currency
  else
    assign discount_display = savings_cents | money
  endif
%}

<div class="{{ class }}">
  <div class="{{ class_inner }}" style="padding-block-end: 1.2rem;">
    {%- comment -%}
      Øverste bånd: Rabat + Subtotal til venstre, tag-ikon (rabatkode) til højre.
      De ligger på SAMME række (items-start), så ikonet ikke skubber totalerne ned.
    {%- endcomment -%}
    {%- liquid
      if context == 'drawer'
        unless section.settings.cart_addons_inherit_color_scheme
          assign color_scheme = section.settings.cart_addons_color_scheme
        else
          unless settings.dialog_color_scheme_inherit
            assign color_scheme = settings.dialog_color_scheme
          else
            assign color_scheme = settings.color_schemes | first
          endunless
        endunless

        assign gift_summary_addon = false
        if settings.gift_wrap_product != blank
          assign gift_wrap_product = all_products[settings.gift_wrap_product]
          if gift_wrap_product != blank and gift_wrap_product.selected_or_first_available_variant != blank
            assign gift_summary_addon = true
          endif
        endif

        assign has_addons = false
        if settings.show_add_discount_code or settings.show_cart_note or settings.show_caculate_shipping_rate or gift_summary_addon
          assign has_addons = true
        endif
      endif
    -%}
    <div class="cart-summary__head flex items-start justify-between gap-4">
      {%- comment -%} Totaler: Rabat + Subtotal i to linjer {%- endcomment -%}
      <div class="cart-summary__totals flex flex-col gap-1 flex-1 min-w-0">
        {%- if savings_cents > 0 -%}
          <div class="cart-summary__row cart-summary__row--discount flex justify-between gap-2">
            <span class="cart-summary__row-label">{{ discount_label }}</span>
            <span class="cart-summary__row-value color-subtext">-{{ discount_display }}</span>
          </div>
        {%- endif -%}
        <div class="cart-summary__row cart-summary__row--subtotal flex justify-between gap-2" role="status">
          <span class="cart-summary__row-label cart-summary__total-label">{{ subtotal_label }}</span>
          <span
            ref="cartTotal"
            value="{{ total_price | strip_html }}"
            class="cart-summary__row-value cart-summary__total-value"
            {% comment %} ref + data-cart-subtotal bruges af kurv-JS og payment_terms — må ikke fjernes {% endcomment %}
            data-cart-subtotal
          >
            <span class="price">{{ total_price }}</span>
          </span>
        </div>
      </div>

      {%- comment -%} Tag-ikon (rabatkode m.m.) til højre — skubber ikke totalerne ned {%- endcomment -%}
      {% if context == 'drawer' and has_addons %}
        <div class="{{ class_addons }} shrink-0">
          {% if gift_summary_addon %}
            {% render 'cart-gift-wrapping-drawer', color_scheme: color_scheme %}
          {% endif %}
          {% if settings.show_add_discount_code %}
            {% render 'cart-discount-drawer', section_id: section.id, color_scheme: color_scheme %}
          {% endif %}
          {% if settings.show_cart_note %}
            {% render 'cart-note-drawer', color_scheme: color_scheme %}
          {% endif %}
          {% if settings.show_caculate_shipping_rate %}
            {% render 'cart-shipping-drawer', color_scheme: color_scheme %}
          {% endif %}
        </div>
      {% endif %}
    </div>

    {%- comment -%} Kun checkout-knap (ingen "Se kurv"), med subtotal i teksten {%- endcomment -%}
    <div class="flex flex-col gap-2">
      <button
        type="submit"
        id="checkout"
        class="cart-summary__checkout-button btn btn--primary flex-1"
        name="checkout"
        {% if cart == empty %}
          disabled
        {% endif %}
        form="cart-form"
      >
        <span class="btn__text">{{ checkout_label }} ({{ total_price }})</span>
      </button>

      {% if additional_checkout_buttons and settings.show_accelerated_checkout_buttons %}
        <div class="additional-checkout-buttons additional-checkout-buttons--vertical">
          {{ content_for_additional_checkout_buttons }}
        </div>
      {% endif %}

      {%- comment -%} Egne betalingsikoner — minimal top/bund-padding {%- endcomment -%}
      <div class="WI_paymentIcons">
        {%- assign cart_payment_methods = 'dankort,visa,master,apple_pay,mobilepay,google_pay' | split: ',' -%}
        {%- for method in cart_payment_methods -%}
          {%- render 'martilness-payment-icon', type: method -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>
<style>
  .cart-drawer-summary .cart-summary__row--subtotal,
  .cart-drawer-summary .cart-summary__row--discount {
    font-size: var(--font-size--paragraph);
    font-family: var(--font-button--family);
    font-weight: var(--font-button--weight);
    line-height: 1.4;
  }
  .cart-drawer-summary .cart-summary__checkout-button .btn__text {
    font-size: var(--font-size--paragraph);
  }
  .cart-drawer-summary .WI_paymentIcons {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin: 4px 0 0;
  }
  .cart-drawer-summary .WI_paymentIcons svg {
    display: block;
    width: 38px;
    height: 24px;
    flex: none;
  }
</style>
