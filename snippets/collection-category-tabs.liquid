{%- liquid
  assign current_handle = closest.collection.handle | default: collection.handle
  assign tab_handles = 'saunataeppe,infrarod-led-maske,infrarodt-lys,isbad-dampsauna,isbad' | split: ','
  assign tab_titles = 'Saunatæppe,Infrarød LED maske,Infrarødt lys,Isbad + Dampsauna,Isbad' | split: ','
-%}
<nav class="collection-category-tabs tabs" aria-label="Kategorier">
  <div class="collection-category-tabs__list flex flex-wrap justify-start gap-2">
    {%- for handle in tab_handles -%}
      {%- assign tab_collection = collections[handle] -%}
      {%- assign tab_title = tab_titles[forloop.index0] -%}
      {%- assign tab_url = tab_collection.url | default: '/collections/' | append: handle -%}
      <a
        href="{{ tab_url }}"
        class="tabs__button inline-flex items-center justify-center relative rounded"
        {% if current_handle == handle %}
          aria-selected="true"
          aria-current="page"
        {% endif %}
      >
        <span class="tabs__button-text relative text-ellipsis">{{ tab_title }}</span>
      </a>
    {%- endfor -%}
  </div>
</nav>
