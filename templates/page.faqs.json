                  },
                  "block_order": [
                    "text_NAC8xf"
                  ]
                },
                "accordion_row_gMBTDG": {
                  "type": "_accordion-row",
                  "settings": {
                    "text": "Har I diskret levering?",
                    "open_row_by_default": false,
                    "icon": "none",
                    "icon_size": "extra-large",
                    "width": 24,
                    "width_mobile": 24
                  },
                  "blocks": {
                    "text_fX9NGW": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Ja. Alle pakker sendes neutralt og diskret, der står ingen produktnavne eller oplysninger, der afslører indholdet. Diskret levering er standard hos os, og vi ved, hvor vigtigt det er for kunder, at pakken kan afhentes uden nysgerrige blikke.</p>",
                        "highlight_style": "none",
                        "highlight_font_style": "italic",
                        "highlight_shape_color": "",
                        "highlight_text_color": "",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "font_weight": "",
                        "font_size": 15,
                        "font_size_mobile": 15,
                        "line_height": "normal",
