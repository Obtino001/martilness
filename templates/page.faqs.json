                  "blocks": {
                    "text_ipipjb": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Sauna er et naturligt stof fra cannabisplanten, som ikke giver rus. Det er blevet populært, fordi det repræsenterer plantens egenskaber uden den psykoaktive effekt, som mange forbinder med cannabis.</p>",
