                  },
                  "block_order": [
                    "text_JQLGHr"
                  ]
                },
                "accordion_row_36nwRD": {
                  "type": "_accordion-row",
                  "settings": {
                    "text": "Hvad er jeres returpolitik?",
                    "open_row_by_default": false,
                    "icon": "none",
                    "icon_size": "extra-large",
                    "width": 24,
                    "width_mobile": 24
                  },
                  "blocks": {
                    "text_8cBwnj": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Vores produkter er lovlige, men vi er også ærlige: for et utrænet øje kan de ligne ulovlig cannabis. Derfor anbefaler vi altid, at produkterne opbevares i deres originale emballage. Skulle der mod forventning opstå tvivl, har du ret til at få foretaget en laboratorietest og modtage kvittering for eventuel konfiskation. Produkterne er dokumenterede, og sager som disse frafalder typisk efter test. Du er altid velkommen til at kontakte os, hvis du har spørgsmål.</p>",
                        "highlight_style": "none",
                        "highlight_font_style": "italic",
                        "highlight_shape_color": "",
