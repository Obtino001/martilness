                    "width": 24,
                    "width_mobile": 24
                  },
                  "blocks": {
                    "text_NAC8xf": {
                      "type": "text",
                      "settings": {
                        "text": "<p>For mindre ordrer starter fragten fra 39 kr., afhængigt af størrelse og leveringsmetode. Køber du for over 499 kr., får du automatisk gratis levering til nærmeste pakkeshop.</p>",
                        "highlight_style": "none",
                        "highlight_font_style": "italic",
                        "highlight_shape_color": "",
                        "highlight_text_color": "",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
