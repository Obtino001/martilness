                  ]
                },
                "accordion_row_86UyzQ": {
                  "type": "_accordion-row",
                  "settings": {
                    "text": "Hvordan kontakter jeg jer af jeres produkter?",
                    "open_row_by_default": false,
                    "icon": "none",
                    "icon_size": "extra-large",
                    "width": 24,
                    "width_mobile": 24
                  },
                  "blocks": {
                    "text_pnwNHx": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Nej. Du bliver ikke skæv af vores produkter. Den rus, man forbinder med cannabis, kommer fra ulovlige produkter med højt THC-indhold, som sælges uden dokumentation. Det er ikke det, vi sælger. Hos Martilness får du kun lovlige og certificerede produkter.</p>",
                        "highlight_style": "none",
                        "highlight_font_style": "italic",
