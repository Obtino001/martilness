                    "width_mobile": 24
                  },
                  "blocks": {
                    "text_kPc8YV": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Hos Martilness kan du vælge mellem flere sikre og populære betalingsmetoder: Visa, Mastercard, Dankort, MobilePay, Apple Pay, Google Pay og ViaBill. Vi har gjort det nemt at betale, uanset hvilken løsning du foretrækker, og alle metoder er krypterede og sikre. Det betyder, at du kan gennemføre dit køb hurtigt og trygt, både på desktop og mobil.</p>",
                        "highlight_style": "none",
                        "highlight_font_style": "italic",
                        "highlight_shape_color": "",
