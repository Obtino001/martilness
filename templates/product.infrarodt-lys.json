            "custom_liquid_6UVzQf": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "{%- liquid\n  assign items = product.metafields.custom.bundle_items.value\n  assign unit = product.metafields.custom.bundle_unit.value | default: 'g'\n  assign total = 0\n-%}\n{%- if items != blank -%}\n  <div class=\"bundle-contents\">\n    <p class=\"bundle-contents__title\">Denne pakke indeholder</p>\n\n    <ul class=\"bundle-contents__list\" role=\"list\">\n      {%- for entry in items -%}\n        {%- liquid\n          assign item = entry.produkt.value\n          assign qty = entry.gram.value | default: 0 | plus: 0\n          assign total = total | plus: qty\n\n          if item == blank\n            continue\n          endif\n        -%}\n        <li class=\"bundle-contents__row\">\n          {%- if item.featured_image -%}\n            <a class=\"bundle-contents__imglink\" href=\"{{ item.url }}\" tabindex=\"-1\" aria-hidden=\"true\">\n              <img\n                class=\"bundle-contents__img\"\n                src=\"{{ item.featured_image | image_url: width: 144, height: 180, crop: 'center' }}\"\n                alt=\"\"\n                width=\"48\"\n                height=\"60\"\n                loading=\"lazy\"\n              >\n            </a>\n          {%- endif -%}\n\n          <a class=\"bundle-contents__name\" href=\"{{ item.url }}\">{{ item.title }}</a>\n\n          <span class=\"bundle-contents__weight\">\n            <b>{{ qty }}</b>&nbsp;{{ unit }}\n          </span>\n        </li>\n      {%- endfor -%}\n    </ul>\n\n    <div class=\"bundle-contents__total\">\n      <span class=\"bundle-contents__total-label\">I alt</span>\n      <span class=\"bundle-contents__total-weight\"><b>{{ total }}</b>&nbsp;{{ unit }}</span>\n    </div>\n  </div>\n\n  <style>\n    .bundle-contents {\n      /* Local knobs — override these per placement instead of editing rules below */\n      --bundle-media-width: 4.8rem;\n      --bundle-media-height: 6rem;\n      --bundle-media-radius: 0.8rem;\n      --bundle-row-padding: 0.6rem;\n      --bundle-chip-background: rgb(var(--color-foreground) / 0.06);\n      --bundle-rule: 0.1rem solid rgb(var(--color-border) / var(--color-border-alpha));\n      --bundle-rule-soft: 0.1rem solid rgb(var(--color-border) / calc(var(--color-border-alpha) * 0.6));\n\n      margin-block-start: var(--spacing-3);\n      padding-block-start: var(--spacing-2);\n      border-block-start: var(--bundle-rule);\n    }\n\n    /* Label styling borrowed from the theme's subheading role */\n    .bundle-contents__title,\n    .bundle-contents__total-label {\n      font-family: var(--font-subheading--family);\n      font-weight: var(--font-subheading--weight);\n      font-style: var(--font-subheading--style);\n      text-transform: var(--font-subheading--transform);\n      letter-spacing: var(--font-subheading--letter-spacing, 0.05em);\n      font-size: calc(var(--font-size--paragraph) * 0.78);\n      color: var(--color-foreground-secondary);\n    }\n\n    .bundle-contents__title {\n      margin: 0 0 var(--spacing-1);\n    }\n\n    .bundle-contents__list {\n      margin: 0;\n      padding: 0;\n      list-style: none;\n    }\n\n    .bundle-contents__row {\n      display: flex;\n      align-items: center;\n      gap: var(--spacing-3);\n      padding-block: var(--bundle-row-padding);\n      border-block-end: var(--bundle-rule-soft);\n    }\n\n    .bundle-contents__row:last-child {\n      border-block-end: 0;\n    }\n\n    .bundle-contents__imglink {\n      flex: none;\n      display: block;\n      line-height: 0;\n    }\n\n    .bundle-contents__img {\n      width: var(--bundle-media-width);\n      height: var(--bundle-media-height);\n      border-radius: var(--bundle-media-radius);\n      object-fit: cover;\n      border: 0.1rem solid rgb(var(--color-border) / var(--color-border-alpha));\n    }\n\n    /* Product name inherits the product-card title role */\n    .bundle-contents__name {\n      min-width: 0;\n      font-family: var(--font-pcard-title--family);\n      font-weight: var(--font-pcard-title--weight);\n      font-style: var(--font-pcard-title--style);\n      font-size: calc(var(--font-size--paragraph) * 0.93);\n      line-height: var(--line-height--body-normal);\n      color: rgb(var(--color-foreground));\n      text-decoration: none;\n      display: -webkit-box;\n      -webkit-line-clamp: 2;\n      line-clamp: 2;\n      -webkit-box-orient: vertical;\n      overflow: hidden;\n    }\n\n    @media (hover: hover) {\n      .bundle-contents__name:hover {\n        text-decoration: underline;\n        text-underline-offset: 0.2rem;\n      }\n    }\n\n    /* Numeric chips use the price role so figures match the rest of the PDP */\n    .bundle-contents__weight,\n    .bundle-contents__total-weight {\n      flex-shrink: 0;\n      white-space: nowrap;\n      display: inline-flex;\n      align-items: baseline;\n      gap: 0.1rem;\n      font-size: calc(var(--font-size--paragraph) * 0.76);\n      color: var(--color-foreground-secondary);\n      font-variant-numeric: tabular-nums;\n    }\n\n    .bundle-contents__weight b,\n    .bundle-contents__total-weight b {\n      font-family: var(--font-pcard-price--family);\n      font-weight: var(--font-pcard-price--weight);\n      font-style: var(--font-pcard-price--style);\n      color: rgb(var(--color-foreground));\n    }\n\n    .bundle-contents__weight {\n      margin-inline-start: auto;\n      background: var(--bundle-chip-background);\n      border-radius: 99rem;\n      padding: 0.4rem 1.1rem;\n    }\n\n    .bundle-contents__weight b {\n      font-size: calc(var(--font-size--paragraph) * 0.93);\n    }\n\n    .bundle-contents__total {\n      display: flex;\n      justify-content: space-between;\n      align-items: baseline;\n      margin-block-start: var(--spacing-2);\n      padding-block-start: var(--spacing-2);\n      border-block-start: var(--bundle-rule);\n    }\n\n    .bundle-contents__total-weight {\n      padding-inline-end: 1.1rem;\n    }\n\n    .bundle-contents__total-weight b {\n      font-size: calc(var(--font-size--paragraph) * 1.07);\n    }\n  </style>\n{%- endif -%}",
