{%- liquid
  assign tab_text = block.settings.text
  assign tab_link = block.settings.link
  assign tab_handle = tab_link | split: '/collections/' | last | split: '?' | first
-%}
{%- if tab_text != blank and tab_link != blank -%}
  <a
    href="{{ routes.all_products_collection_url }}?mt_collection={{ tab_handle | url_encode }}"
    class="tabs__button inline-flex items-center justify-center relative rounded"
    data-collection-tab="{{ tab_handle | escape }}"
    data-collection-source="{{ tab_link | escape }}"
    aria-selected="false"
    {{ block.shopify_attributes }}
  >
    <span class="tabs__button-text relative text-ellipsis">{{ tab_text }}</span>
  </a>
{%- endif -%}
{% schema %}
{
  "name": "Tab",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    }
  ],
  "presets": [
    {
      "name": "Tab"
    }
  ]
}
{% endschema %}
