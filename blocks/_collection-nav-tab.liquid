{%- liquid
  assign tab_text = block.settings.text
  assign tab_link = block.settings.link
  assign current = closest.collection | default: collection
  assign is_active = false

  if tab_link != blank and current.handle != blank
    assign collection_path = '/collections/' | append: current.handle
    assign shopify_path = 'shopify://collections/' | append: current.handle
    if tab_link == current.url or tab_link == collection_path or tab_link == shopify_path
      assign is_active = true
    endif
  endif
-%}
{%- if tab_text != blank -%}
  <a
    href="{{ tab_link | default: '#' }}"
    class="tabs__button inline-flex items-center justify-center relative rounded"
    {% if is_active %}
      aria-selected="true"
      aria-current="page"
    {% endif %}
    {{ block.shopify_attributes }}
  >
    <span class="tabs__button-text relative text-ellipsis">{{ tab_text }}</span>
  </a>
{%- endif -%}
{% schema %}
{
  "name": "Tab",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    }
  ],
  "presets": [
    {
      "name": "Tab"
    }
  ]
}
{% endschema %}
