{%- liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif
  assign variant = product.selected_or_first_available_variant
  assign unit = variant.price | default: 0
  assign unit_compare = variant.compare_at_price | default: unit
  if unit_compare < unit
    assign unit_compare = unit
  endif
  assign addon = block.settings.addon_product
  assign radio_name = 'qty-bundle-' | append: section.id | append: '-' | append: block.id
  assign bundle_name = block.settings.product_label | strip
  if bundle_name == blank
    assign bundle_name = product.title | split: '|' | first | strip
  endif
-%}

{%- if product != blank and variant != blank -%}
  <link rel="stylesheet" href="{{ 'quantity-bundle.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>{{ 'quantity-bundle.css' | asset_url | stylesheet_tag }}</noscript>
  <script src="{{ 'quantity-bundle.js' | asset_url }}" type="module" fetchpriority="low"></script>

  <quantity-bundle
    id="qty-bundle-{{ block.id }}"
    class="qty-bundle spacing-style"
    style="{% if block.settings.accent_color != blank %}--qty-accent: {{ block.settings.accent_color }};{% endif %} {% render 'spacing-style', settings: block.settings %}"
    data-product-id="{{ product.id }}"
    data-variant-id="{{ variant.id }}"
    data-unit="{{ unit }}"
    data-unit-compare="{{ unit_compare }}"
    data-after-add="{{ block.settings.after_add }}"
    data-replace-buy="{% if block.settings.replace_buy_buttons %}true{% else %}false{% endif %}"
    data-flex-max="{{ block.settings.flex_max }}"
    data-addon-sync="{% if block.settings.addon_sync_qty %}true{% else %}false{% endif %}"
    data-live="{% if block.settings.show_live %}true{% else %}false{% endif %}"
    data-live-min="{{ block.settings.live_min }}"
    data-live-max="{{ block.settings.live_max }}"
    data-save-prefix="{{ block.settings.pill_prefix | escape }}"
    data-save-line="{{ block.settings.save_label | escape }}"
    {% if block.settings.product_label != blank %}data-fixed-name="true"{% endif %}
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.eyebrow != blank -%}
      <p class="qty-bundle__eyebrow color-subtext">{{ block.settings.eyebrow | escape }}</p>
    {%- endif -%}

    <div class="qty-bundle__tiers" role="radiogroup" aria-label="{{ block.settings.eyebrow | default: product.title | escape }}">
      {%- for i in (1..3) -%}
        {%- liquid
          assign show_key = 'show_tier_' | append: i
          assign qty_key = 'qty_' | append: i
          assign disc_key = 'discount_' | append: i
          if block.settings[show_key] == false
            continue
          endif
          assign qty = block.settings[qty_key]
          assign discount = block.settings[disc_key]
          assign is_flex = false
          if i == 3 and block.settings.enable_flex
            assign is_flex = true
          endif
          assign selected = false
          if block.settings.default_tier == i
            assign selected = true
          endif
          assign is_popular = false
          if block.settings.popular_tier == i and block.settings.popular_badge != blank
            assign is_popular = true
          endif
          assign sub_key = 'subtitle_' | append: i
          assign subtitle = block.settings[sub_key]
          assign keep = 100 | minus: discount
          assign now = unit | times: qty | times: keep | divided_by: 100
          assign compare = unit_compare | times: qty
          assign pct = 0
          if discount > 0
            assign pct = discount
          elsif compare > now
            assign pct = compare | minus: now | times: 100.0 | divided_by: compare | round
          endif
        -%}
        <label
          class="qty-bundle__tier{% if selected %} is-selected{% endif %}{% if is_popular %} is-popular{% endif %}"
          data-index="{{ i }}"
          data-qty="{{ qty }}"
          data-discount="{{ discount }}"
          data-flex="{% if is_flex %}true{% else %}false{% endif %}"
        >
          {%- if is_popular -%}
            <span class="qty-bundle__badge badge badge--popular">{{ block.settings.popular_badge | escape }}</span>
          {%- endif -%}
          <input
            type="radio"
            name="{{ radio_name }}"
            class="qty-bundle__radio"
            {% if selected %}
              checked
            {% endif %}
          >
          <span class="qty-bundle__ring" aria-hidden="true"></span>
          <span class="qty-bundle__info">
            <span class="qty-bundle__label">
              {%- if is_flex -%}
                <span data-lblq="">{{ qty }}</span>× <span data-pname>{{ bundle_name | escape }}</span>
              {%- else -%}
                {{ qty }}× <span data-pname>{{ bundle_name | escape }}</span>
              {%- endif -%}
            </span>
            {%- if subtitle != blank -%}
              <span class="qty-bundle__sub">{{ subtitle | escape }}</span>
            {%- endif -%}
            {%- if is_flex -%}
              <span class="qty-bundle__step quantity-selector relative inline-flex min-w-0" data-context="cart-items">
                <button
                  type="button"
                  class="quantity-minus quantity-button button-unstyled absolute flex items-center justify-center text-center cursor-pointer"
                  data-step="-"
                  aria-label="{{ 'accessibility.decrease_quantity' | t }}"
                  disabled
                >
                  {% render 'icon', icon: 'minus', size: 'extra-small' %}
                </button>
                <span class="quantity-input w-full text-center min-w-0 qty-bundle__q" data-q="">{{ qty }}</span>
                <button
                  type="button"
                  class="quantity-plus quantity-button button-unstyled absolute flex items-center justify-center text-center cursor-pointer"
                  data-step="+"
                  aria-label="{{ 'accessibility.increase_quantity' | t }}"
                >
                  {% render 'icon', icon: 'plus', size: 'extra-small' %}
                </button>
              </span>
            {%- endif -%}
          </span>
          <span class="qty-bundle__pricing">
            <span class="qty-bundle__pill badge badge--sale" data-pill="">
              {%- if pct > 0 -%}{{ block.settings.pill_prefix }} {{ pct }}%{%- endif -%}
            </span>
            <span class="qty-bundle__price price" data-price-out="">{{ now | money }}</span>
            <span class="qty-bundle__comp compare-at-price" data-comp="">
              {%- if compare > now -%}{{ compare | money }}{%- endif -%}
            </span>
          </span>
        </label>
      {%- endfor -%}
    </div>

    {%- if block.settings.show_addon and addon != blank -%}
      {%- liquid
        assign addon_variant = addon.selected_or_first_available_variant
        assign addon_label = block.settings.addon_label | default: addon.title
      -%}
      <div
        class="qty-bundle__addon{% if block.settings.addon_default_on %} is-on{% endif %}"
        data-addon
        data-max="{{ block.settings.addon_max }}"
        data-hint-off="{{ block.settings.addon_hint_off | escape }}"
        data-hint-on="{{ block.settings.addon_hint_on | escape }}"
      >
        <div class="qty-bundle__atop" data-atop role="button" tabindex="0" aria-pressed="{% if block.settings.addon_default_on %}true{% else %}false{% endif %}">
          <span class="qty-bundle__chk" aria-hidden="true"></span>
          <span class="qty-bundle__athumb">
            {%- if addon.featured_image -%}
              {{
                addon.featured_image
                | image_url: width: 96
                | image_tag: loading: 'lazy', widths: '46, 92', sizes: '46px', alt: addon.title
              }}
            {%- endif -%}
          </span>
          <span class="qty-bundle__ainfo">
            <span class="qty-bundle__albl">{{ addon_label | escape }}</span>
            <span class="qty-bundle__apr">
              <span data-cover-now>+ {{ addon_variant.price | money }}/stk.</span>
              {%- if addon_variant.compare_at_price > addon_variant.price -%}
                <span class="qty-bundle__apr-was" data-cover-was>{{ addon_variant.compare_at_price | money }}</span>
              {%- endif -%}
            </span>
          </span>
          <span class="qty-bundle__ahint" data-ahint>
            {%- if block.settings.addon_default_on -%}
              {{ block.settings.addon_hint_on }}
            {%- else -%}
              {{ block.settings.addon_hint_off }}
            {%- endif -%}
          </span>
        </div>
        <div class="qty-bundle__exp">
          <div class="qty-bundle__expin">
            <div class="qty-bundle__cnt">
              <span class="qty-bundle__cnt-l color-subtext">{{ block.settings.addon_qty_label }}</span>
              <span class="qty-bundle__step quantity-selector relative inline-flex min-w-0" data-context="cart-items">
                <button
                  type="button"
                  class="quantity-minus quantity-button button-unstyled absolute flex items-center justify-center text-center cursor-pointer"
                  data-cs="-"
                  aria-label="{{ 'accessibility.decrease_quantity' | t }}"
                >
                  {% render 'icon', icon: 'minus', size: 'extra-small' %}
                </button>
                <span class="quantity-input w-full text-center min-w-0 qty-bundle__q" data-ccount>0</span>
                <button
                  type="button"
                  class="quantity-plus quantity-button button-unstyled absolute flex items-center justify-center text-center cursor-pointer"
                  data-cs="+"
                  aria-label="{{ 'accessibility.increase_quantity' | t }}"
                >
                  {% render 'icon', icon: 'plus', size: 'extra-small' %}
                </button>
              </span>
            </div>
            <div data-rows></div>
          </div>
        </div>
        <script type="application/json" data-covers>
          [
            {%- for cover in addon.variants -%}
              {%- assign cover_image = cover.featured_image | default: addon.featured_image -%}
              {
                "id": {{ cover.id }},
                "title": {{ cover.title | json }},
                "price": {{ cover.price }},
                "compare": {{ cover.compare_at_price | default: cover.price }},
                "available": {% if cover.available %}true{% else %}false{% endif %},
                "image": {% if cover_image %}{{ cover_image | image_url: width: 120 | json }}{% else %}null{% endif %}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        </script>
      </div>
    {%- endif -%}

    <div class="qty-bundle__div"></div>
    <div class="qty-bundle__total">
      <span class="qty-bundle__total-l color-subtext">{{ block.settings.total_label | escape }}</span>
      <span class="qty-bundle__total-r">
        <span class="qty-bundle__total-comp compare-at-price" data-total-compare></span>
        <span class="qty-bundle__total-now price" data-total></span>
      </span>
    </div>
    {%- if block.settings.show_save -%}
      <div class="qty-bundle__save" data-save></div>
    {%- endif -%}

    {%- if block.settings.show_live -%}
      {%- assign live_parts = block.settings.live_text | split: '[count]' -%}
      <div class="qty-bundle__live">
        <span class="qty-bundle__dot" aria-hidden="true"></span>
        <span>
          {%- if live_parts.size == 2 -%}
            {{ live_parts[0] | escape }}<b data-live-n></b>{{ live_parts[1] | escape }}
          {%- else -%}
            <b data-live-n></b> {{ block.settings.live_text | escape }}
          {%- endif -%}
        </span>
      </div>
    {%- endif -%}

    {%- liquid
      assign cta_label = block.settings.cta_label
      if cta_label == blank
        assign cta_label = 'actions.add_to_cart' | t
      endif
    -%}
    <div class="qty-bundle__cta-wrap">
      <button type="button" class="btn btn--primary w-full add-to-cart-button btn--icon-solid" data-cta>
        <span class="btn__text add-to-cart-text">
          <span class="add-to-cart-text__content">{{ cta_label | escape }}</span>
        </span>
        <span class="add-to-cart-icon btn__icon">
          <span class="btn__icon-text">{{ cta_label | escape }}</span>
          <span class="btn__icon-icon">{% render 'icon', icon: 'cart' %}</span>
        </span>
        {% render 'loading-spinner', class: 'add-to-cart-spinner hidden' %}
      </button>
    </div>
    <div class="pr-bar qty-bundle__pr-bar">
      <div class="pr-bar__pay">
        {%- assign buy_payment_methods = 'dankort,visa,master,apple_pay,mobilepay,google_pay' | split: ',' -%}
        {%- for method in buy_payment_methods -%}
          {%- render 'martilness-payment-icon', type: method -%}
        {%- endfor -%}
      </div>
      <div class="pr-bar__rating">
        <span class="pr-bar__score">4.8/5</span>
        <div class="pr-bar__stars">
          {%- for i in (1..5) -%}
            <span class="pr-bar__star">
              <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            </span>
          {%- endfor -%}
        </div>
      </div>
    </div>
    <p class="qty-bundle__error product-form-text__error alert alert--error text-body-sm hidden" data-error></p>

    {%- if block.settings.show_reassure -%}
      <div class="qty-bundle__reassure">
        {%- if block.settings.reassure_1 != blank -%}
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="m9 12 2 2 4-4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            {{ block.settings.reassure_1 | escape }}
          </span>
        {%- endif -%}
        {%- if block.settings.reassure_2 != blank -%}
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"></path><circle cx="7" cy="18" r="1.6"></circle><circle cx="17" cy="18" r="1.6"></circle></svg>
            {{ block.settings.reassure_2 | escape }}
          </span>
        {%- endif -%}
        {%- if block.settings.reassure_3 != blank -%}
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m9 11 2 2 4-4"></path><path d="M12 3l2.3 1.7 2.8-.2.9 2.7 2.3 1.6-.9 2.7.9 2.7-2.3 1.6-.9 2.7-2.8-.2L12 21l-2.3-1.7-2.8.2-.9-2.7L3.7 15l.9-2.7-.9-2.7 2.3-1.6.9-2.7 2.8.2Z" stroke-linejoin="round"></path></svg>
            {{ block.settings.reassure_3 | escape }}
          </span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </quantity-bundle>
{%- endif -%}

{% schema %}
{
  "name": "Quantity bundle",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "1× / 2× / 3× er altid dette produkt (valgt variant). Addon nedenfor er et separat produkt. Rabat-% er visning — opret volume-rabat i Shopify Admin for rigtig prisnedsættelse."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Overskrift",
      "default": "Hvor mange har du brug for?"
    },
    {
      "type": "text",
      "id": "product_label",
      "label": "Navn i pakker",
      "info": "Tom = produkttitel (tekst før | )"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "info": "Tom = temaets primære knapfarve",
      "default": "#09412d"
    },
    {
      "type": "checkbox",
      "id": "replace_buy_buttons",
      "label": "Skjul standard 'Læg i kurv'",
      "default": true
    },
    {
      "type": "select",
      "id": "after_add",
      "label": "Efter tilføjelse",
      "options": [
        { "value": "cart", "label": "Åbn kurv" },
        { "value": "checkout", "label": "Gå til checkout" }
      ],
      "default": "cart"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Knaptekst",
      "info": "Tom = temaets 'Læg i kurv'",
      "default": "Tilføj til kurv"
    },
    {
      "type": "header",
      "content": "Pakke 1"
    },
    {
      "type": "checkbox",
      "id": "show_tier_1",
      "label": "Vis",
      "default": true
    },
    {
      "type": "range",
      "id": "qty_1",
      "label": "Antal",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 1,
      "visible_if": "{{ block.settings.show_tier_1 }}"
    },
    {
      "type": "range",
      "id": "discount_1",
      "label": "Rabat %",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 0,
      "visible_if": "{{ block.settings.show_tier_1 }}"
    },
    {
      "type": "header",
      "content": "Pakke 2"
    },
    {
      "type": "checkbox",
      "id": "show_tier_2",
      "label": "Vis",
      "default": true
    },
    {
      "type": "range",
      "id": "qty_2",
      "label": "Antal",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 2,
      "visible_if": "{{ block.settings.show_tier_2 }}"
    },
    {
      "type": "range",
      "id": "discount_2",
      "label": "Rabat %",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 0,
      "visible_if": "{{ block.settings.show_tier_2 }}"
    },
    {
      "type": "header",
      "content": "Pakke 3 (flex)"
    },
    {
      "type": "checkbox",
      "id": "show_tier_3",
      "label": "Vis",
      "default": true
    },
    {
      "type": "range",
      "id": "qty_3",
      "label": "Start antal",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3,
      "visible_if": "{{ block.settings.show_tier_3 }}"
    },
    {
      "type": "range",
      "id": "discount_3",
      "label": "Rabat %",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 0,
      "visible_if": "{{ block.settings.show_tier_3 }}"
    },
    {
      "type": "checkbox",
      "id": "enable_flex",
      "label": "Plus/minus på pakke 3",
      "default": true,
      "visible_if": "{{ block.settings.show_tier_3 }}"
    },
    {
      "type": "range",
      "id": "flex_max",
      "label": "Max antal",
      "min": 3,
      "max": 20,
      "step": 1,
      "default": 8,
      "visible_if": "{{ block.settings.show_tier_3 and block.settings.enable_flex }}"
    },
    {
      "type": "range",
      "id": "default_tier",
      "label": "Valgt som standard (1–3)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "popular_tier",
      "label": "Mest populær (0 = skjult)",
      "min": 0,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "text",
      "id": "popular_badge",
      "label": "Populær-badge",
      "default": "Mest populær",
      "visible_if": "{{ block.settings.popular_tier > 0 }}"
    },
    {
      "type": "text",
      "id": "subtitle_1",
      "label": "Pakke 1 undertekst"
    },
    {
      "type": "text",
      "id": "subtitle_2",
      "label": "Pakke 2 undertekst"
    },
    {
      "type": "text",
      "id": "subtitle_3",
      "label": "Pakke 3 undertekst"
    },
    {
      "type": "text",
      "id": "pill_prefix",
      "label": "Spar-badge",
      "default": "Spar"
    },
    {
      "type": "header",
      "content": "Tilbehør (addon)"
    },
    {
      "type": "checkbox",
      "id": "show_addon",
      "label": "Vis addon",
      "default": false
    },
    {
      "type": "product",
      "id": "addon_product",
      "label": "Addon-produkt"
    },
    {
      "type": "text",
      "id": "addon_label",
      "label": "Addon-label",
      "info": "Tom = produktets titel",
      "visible_if": "{{ block.settings.show_addon }}"
    },
    {
      "type": "text",
      "id": "addon_hint_off",
      "label": "Hint (fra)",
      "default": "Anbefalet",
      "visible_if": "{{ block.settings.show_addon }}"
    },
    {
      "type": "text",
      "id": "addon_hint_on",
      "label": "Hint (til)",
      "default": "Tilføjet",
      "visible_if": "{{ block.settings.show_addon }}"
    },
    {
      "type": "checkbox",
      "id": "addon_default_on",
      "label": "Tilføjet som standard",
      "default": false,
      "visible_if": "{{ block.settings.show_addon }}"
    },
    {
      "type": "checkbox",
      "id": "addon_sync_qty",
      "label": "Addon-antal følger hovedprodukt",
      "default": true,
      "visible_if": "{{ block.settings.show_addon }}"
    },
    {
      "type": "range",
      "id": "addon_max",
      "label": "Addon max antal",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 8,
      "visible_if": "{{ block.settings.show_addon }}"
    },
    {
      "type": "text",
      "id": "addon_qty_label",
      "label": "Addon antal-label",
      "default": "Antal",
      "visible_if": "{{ block.settings.show_addon }}"
    },
    {
      "type": "header",
      "content": "Total & live"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total-label",
      "default": "Din pris i alt"
    },
    {
      "type": "checkbox",
      "id": "show_save",
      "label": "Vis besparelse",
      "default": true
    },
    {
      "type": "text",
      "id": "save_label",
      "label": "Besparelsestekst",
      "default": "Du sparer {amount}",
      "info": "{amount} erstattes med beløbet",
      "visible_if": "{{ block.settings.show_save }}"
    },
    {
      "type": "checkbox",
      "id": "show_live",
      "label": "Vis 'i kurven nu'",
      "default": true
    },
    {
      "type": "range",
      "id": "live_min",
      "label": "Live min",
      "min": 1,
      "max": 99,
      "step": 1,
      "default": 20,
      "visible_if": "{{ block.settings.show_live }}"
    },
    {
      "type": "range",
      "id": "live_max",
      "label": "Live max",
      "min": 1,
      "max": 99,
      "step": 1,
      "default": 80,
      "visible_if": "{{ block.settings.show_live }}"
    },
    {
      "type": "text",
      "id": "live_text",
      "label": "Live-tekst",
      "default": "[count] har den i kurven lige nu",
      "info": "[count] bliver til tallet",
      "visible_if": "{{ block.settings.show_live }}"
    },
    {
      "type": "header",
      "content": "Tryghed"
    },
    {
      "type": "checkbox",
      "id": "show_reassure",
