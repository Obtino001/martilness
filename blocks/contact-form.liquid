{%- liquid
  assign form_id = 'ContactForm-' | append: block.id

  assign is_reklamation = false
  if template.suffix == 'reklamation' or page.handle == 'reklamation' or request.path contains 'reklamation'
    assign is_reklamation = true
  elsif block.settings.show_default_name == false or block.settings.show_default_email == false or block.settings.show_default_message == false
    assign is_reklamation = true
  endif

  assign show_name = true
  if is_reklamation or block.settings.show_default_name == false
    assign show_name = false
  endif

  assign show_email = true
  if is_reklamation or block.settings.show_default_email == false
    assign show_email = false
  endif

  assign show_message = true
  if is_reklamation or block.settings.show_default_message == false
    assign show_message = false
  endif

  assign submit_label = block.settings.submit_button_label
  if submit_label == blank
    if is_reklamation
      assign submit_label = 'SEND'
    else
      assign submit_label = 'blocks.contact_form.send_message' | t
    endif
  endif
-%}
<div
  class="contact-form size-style{% if is_reklamation %} contact-form--reklamation{% endif %}"
  style="{% render 'size-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  {% comment %} Contact Form {% endcomment %}
  {%- form 'contact', id: form_id, class: 'w-full', enctype: 'multipart/form-data' -%}
    {%- if form.posted_successfully? -%}
      <div class="form-status-list" role="status">
        <h3
          class="form-message alert alert--success h6 flex gap-2"
          tabindex="-1"
          autofocus
        >
          {% render 'icon', icon: 'check', size: 'small', class: 'shrink-0' %}
          {{- 'blocks.contact_form.post_success' | t -}}
        </h3>
      </div>
    {%- elsif form.errors -%}
      <div class="form-error alert alert--error">
        <h3
          class="form-message form-message--error h6 flex gap-2"
          role="alert"
          tabindex="-1"
          autofocus
        >
          {% render 'icon', icon: 'warning', size: 'small', class: 'shrink-0' %}
          {{- 'blocks.contact_form.error_heading' | t -}}
        </h3>

        <ul role="list">
          <li>
            <a href="#ContactForm-email" class="reversed-link">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </a>
          </li>
        </ul>
      </div>
    {%- endif -%}

    {% comment %} form fields {% endcomment %}
    <div
      class="contact__fields layout-panel-grid gap-style"
      style="{% render 'layout-panel-style', type: 'grid', columns_md: '2' %}{% render 'gap-style', settings: block.settings %}"
    >
      {%- if show_name -%}
        <div class="form-field form-field--name">
          <label class="form-label visually-hidden" for="ContactForm-name-{{ section.id }}">
            {{- 'blocks.contact_form.name' | t -}}
            <span aria-hidden="true">*</span>
          </label>
          <input
            class="form-control w-full"
            autocomplete="name"
            type="text"
            id="ContactForm-name-{{ section.id }}"
            name="contact[{{ 'blocks.contact_form.name' | t }}]"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            placeholder="{{ 'blocks.contact_form.name' | t }}*"
            required
            aria-required="true"
          >
        </div>
      {%- endif -%}

      {%- if show_email -%}
        <div class="form-field form-field--email">
          <label class="form-label visually-hidden" for="ContactForm-email-{{ section.id }}">
            {{- 'blocks.contact_form.email' | t -}}
            <span aria-hidden="true">*</span>
          </label>
          <input
            autocomplete="email"
            type="email"
            id="ContactForm-email-{{ section.id }}"
            class="form-control w-full"
            name="contact[email]"
            spellcheck="false"
            autocapitalize="off"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            required
            placeholder="{{ 'blocks.contact_form.email' | t }}*"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="ContactForm-email-error-{{ section.id }}"
            {% endif %}
          >
          {%- if form.errors contains 'email' -%}
            <span
              class="form-message form-message--small form-message--error flex gap-2"
              id="ContactForm-email-error-{{ section.id }}"
            >
              {% render 'icon', icon: 'warning', class: 'shrink-0' %}
              {{- form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email -}}
            </span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {% comment %} Blocks custom field {% endcomment %}
      {% content_for 'blocks' %}

      {% comment %} form-body {% endcomment %}
      {%- if show_message -%}
        <div class="form-field form-field--full form-field--body">
          <label class="form-label visually-hidden" for="ContactForm-body-{{ section.id }}">
            {{- 'blocks.contact_form.your_message' | t -}}
          </label>
          <textarea
            rows="5"
            id="ContactForm-body-{{ section.id }}"
            class="form-control form-control--textarea w-full"
            name="contact[{{ 'blocks.contact_form.your_message' | t }}]"
            placeholder="{{ 'blocks.contact_form.your_message' | t }}"
          >{%- if form.body -%}{{- form.body -}}{%- endif -%}</textarea>
        </div>
      {%- endif -%}

      {% comment %} button submit {% endcomment %}
      <div class="contact__button form-footer text-center form-field--full{% if is_reklamation %} contact__button--reklamation w-full{% endif %}">
        <button type="submit" class="btn btn--primary btn--large{% unless is_reklamation %} btn--icon-solid{% endunless %}{% if is_reklamation %} btn--reklamation-send w-full{% endif %}">
          <span class="btn__text">{{ submit_label }}</span>
          {%- unless is_reklamation -%}
            <span class="btn__icon">
              <span class="btn__icon-text">{{ submit_label }}</span>
              <span class="btn__icon-icon">
                {% render 'icon', icon: 'caret-right' %}
              </span>
            </span>
          {%- endunless -%}
        </button>
      </div>
    </div>

    {%- if is_reklamation -%}
      <style>
        .contact-form--reklamation .contact__fields {
          row-gap: 16px !important;
          column-gap: 16px !important;
        }
        .contact-form--reklamation .form-control {
          background-color: #eeeeee !important;
          border: 1px solid transparent !important;
          box-shadow: none !important;
          border-radius: 4px !important;
          color: #333333 !important;
          font-size: 15px !important;
          padding: 12px 16px !important;
          height: 48px !important;
        }
        .contact-form--reklamation .form-control::placeholder {
          color: #777777 !important;
          opacity: 1 !important;
        }
        .contact-form--reklamation .form-control:focus {
          background-color: #ffffff !important;
          border-color: #1cb377 !important;
          outline: none !important;
          box-shadow: 0 0 0 1px #1cb377 !important;
        }
        .contact-form--reklamation textarea.form-control {
          height: 110px !important;
          min-height: 100px !important;
          resize: vertical;
        }
        .contact-form--reklamation .select {
          width: 100% !important;
          max-width: 100% !important;
          background-color: #eeeeee !important;
          border-radius: 4px !important;
        }
        .contact-form--reklamation .select select {
          background-color: transparent !important;
          border: none !important;
          height: 48px !important;
          color: #555555 !important;
          font-size: 15px !important;
          padding-left: 16px !important;
        }
        .contact-form--reklamation .form-label--file-heading {
          display: block !important;
          margin-bottom: 8px !important;
          font-size: 15px !important;
          font-weight: 500 !important;
          color: #222222 !important;
        }
        .contact-form--reklamation .form-field--file input[type="file"] {
          height: auto !important;
          padding: 6px 0 !important;
          background: transparent !important;
          border: none !important;
          box-shadow: none !important;
          border-radius: 0 !important;
          font-size: 14px !important;
          color: #333333 !important;
          cursor: pointer !important;
        }
        .contact-form--reklamation .contact__button,
        .contact__button--reklamation {
          width: 100% !important;
          grid-column: 1 / -1 !important;
          margin-top: 8px !important;
        }
        .btn--reklamation-send {
          width: 100% !important;
          background-color: #1cb377 !important;
          border: 1px solid #1cb377 !important;
          color: #ffffff !important;
          border-radius: 4px !important;
          padding: 14px 24px !important;
          font-size: 16px !important;
          font-weight: 700 !important;
          text-transform: uppercase !important;
          letter-spacing: 0.06em !important;
          justify-content: center !important;
          box-shadow: none !important;
          cursor: pointer !important;
          transition: background-color 0.2s ease, border-color 0.2s ease !important;
        }
        .btn--reklamation-send:hover {
          background-color: #169c67 !important;
          border-color: #169c67 !important;
          color: #ffffff !important;
        }
        .btn--reklamation-send .btn__icon {
          display: none !important;
        }
      </style>
    {%- endif -%}
  {%- endform -%}
</div>
{% schema %}
{
  "name": "t:names.contact_form",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:content.mobile_settings"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Default fields"
    },
    {
      "type": "checkbox",
      "id": "show_default_name",
      "label": "Show default name",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_default_email",
      "label": "Show default email",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_default_message",
      "label": "Show default message textarea",
      "default": true
    },
    {
      "type": "text",
      "id": "submit_button_label",
      "label": "Submit button text"
    }
  ],
  "blocks": [
    {
      "type": "_custom-field"
    }
  ],
  "presets": [
    {
      "name": "t:names.contact_form",
      "blocks": [
        {
          "type": "_custom-field",
          "settings": {
            "field_type": "phone",
            "heading": "Phone Number"
          }
        },
        {
          "type": "_custom-field",
          "settings": {
            "field_type": "text",
            "heading": "Order Number"
          }
        },
        {
          "type": "_custom-field",
          "settings": {
            "field_type": "select",
            "heading": "Country",
            "select_options": "Austria,Viet Nam,Japan",
            "full_width": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
