{% doc %}
  Lagerstatus-blok med blinkende prik og leveringstekst.
  Viser "på lager"-tilstand ud fra den valgte variant. Alle tekster og farver kan ændres i temaeditoren.
{% enddoc %}

{%- assign ss_product = closest.product -%}
{%- assign ss_variant = ss_product.selected_or_first_available_variant -%}
{%- if ss_variant.available -%}
  {%- assign ss_dot_color = block.settings.in_stock_color -%}
  {%- assign ss_status_text = block.settings.in_stock_text -%}
  {%- assign ss_sub_text = block.settings.in_stock_sub -%}
{%- else -%}
  {%- assign ss_dot_color = block.settings.oos_color -%}
  {%- assign ss_status_text = block.settings.oos_text -%}
  {%- assign ss_sub_text = block.settings.oos_sub -%}
{%- endif -%}

<div class="stock-status stock-status--{{ block.id }}" {{ block.shopify_attributes }}>
  <span class="stock-status__dot{% if block.settings.enable_pulse %} stock-status__dot--pulse{% endif %}" aria-hidden="true"></span>
  <span class="stock-status__text">
    <span class="stock-status__status">{{ ss_status_text }}</span>
    {%- if ss_sub_text != blank -%}
      <span class="stock-status__sub">&nbsp;{{ ss_sub_text }}</span>
    {%- endif -%}
  </span>
</div>

{% style %}
  .stock-status--{{ block.id }} {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-block-start: {{ block.settings.padding_top }}px;
    padding-block-end: {{ block.settings.padding_bottom }}px;
    font-size: {{ block.settings.font_size }}px;
    line-height: 1.4;
  }
  .stock-status--{{ block.id }} .stock-status__dot {
    position: relative;
    flex-shrink: 0;
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background: {{ ss_dot_color }};
  }
  .stock-status--{{ block.id }} .stock-status__dot--pulse::after {
    content: "";
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background: {{ ss_dot_color }};
    opacity: 0.35;
    animation: stock-status-pulse-{{ block.id }} 1.6s ease-out infinite;
  }
  @keyframes stock-status-pulse-{{ block.id }} {
    0% { transform: scale(0.6); opacity: 0.45; }
    70% { transform: scale(1.4); opacity: 0; }
    100% { transform: scale(1.4); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .stock-status--{{ block.id }} .stock-status__dot--pulse::after { animation: none; opacity: 0.25; }
  }
  .stock-status--{{ block.id }} .stock-status__status {
    color: {{ ss_dot_color }};
    font-weight: 600;
  }
  .stock-status--{{ block.id }} .stock-status__sub {
    color: {{ block.settings.sub_text_color }};
    font-weight: 600;
  }
{% endstyle %}

{% schema %}
{
  "name": "Lagerstatus",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "På lager"
    },
    {
      "type": "text",
      "id": "in_stock_text",
      "label": "Statustekst",
      "default": "På lager."
    },
    {
      "type": "text",
      "id": "in_stock_sub",
      "label": "Undertekst",
      "default": "1-4 hverdages levering"
    },
    {
      "type": "color",
      "id": "in_stock_color",
      "label": "Farve (prik og statustekst)",
      "default": "#2E9E4F"
    },
    {
      "type": "header",
      "content": "Udsolgt"
    },
    {
      "type": "text",
      "id": "oos_text",
      "label": "Statustekst",
      "default": "Udsolgt."
    },
    {
      "type": "text",
      "id": "oos_sub",
      "label": "Undertekst",
      "default": "Kontakt os for forventet leveringstid"
    },
    {
      "type": "color",
      "id": "oos_color",
      "label": "Farve (prik og statustekst)",
      "default": "#D0342C"
    },
    {
      "type": "header",
      "content": "Udseende"
    },
    {
      "type": "checkbox",
      "id": "enable_pulse",
      "label": "Blinkende prik",
      "default": true
    },
    {
      "type": "color",
      "id": "sub_text_color",
      "label": "Farve på undertekst",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "dot_size",
      "label": "Prikkens størrelse",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Tekststørrelse",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Afstand over",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Afstand under",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Lagerstatus"
    }
  ]
}
{% endschema %}
