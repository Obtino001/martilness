{%- liquid
  assign heading = section.settings.heading | default: 'Vi er her for at hjælpe!'
  assign phone = section.settings.phone | default: '+45 2779 6900'
  assign email = section.settings.email | default: 'info@martilness.dk'
  assign phone_href = phone | replace: ' ', ''
  assign form_id = 'MartilnessContact-' | append: section.id
-%}

<div
  id="section-{{ section.id }}"
  class="mt-contact color-{{ section.settings.color_scheme }}"
  style="
    --mt-contact-accent: rgb(var(--color-primary-button-background));
    --mt-contact-pad-top: {{ section.settings.padding_top }}px;
    --mt-contact-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="mt-contact__inner page-width">
    <div class="mt-contact__grid">
      <div class="mt-contact__info">
        {% if heading != blank %}
          <h1 class="mt-contact__heading">{{ heading }}</h1>
        {% endif %}

        {% if section.settings.intro != blank %}
          <div class="mt-contact__intro rte">{{ section.settings.intro }}</div>
        {% endif %}

        {% if section.settings.returns_heading != blank or section.settings.returns_text != blank %}
          <div class="mt-contact__block">
            {% if section.settings.returns_heading != blank %}
              <h2 class="mt-contact__subheading">{{ section.settings.returns_heading }}</h2>
            {% endif %}
            {% if section.settings.returns_text != blank %}
              <div class="mt-contact__text rte">{{ section.settings.returns_text }}</div>
            {% endif %}
          </div>
        {% endif %}

        <div class="mt-contact__block">
          {% if section.settings.company != blank %}
            <h2 class="mt-contact__subheading">{{ section.settings.company }}</h2>
          {% endif %}
          {% if section.settings.address != blank %}
            <div class="mt-contact__text rte">{{ section.settings.address }}</div>
          {% endif %}
        </div>

        <div class="mt-contact__links">
          {% if phone != blank %}
            <a class="mt-contact__link" href="tel:{{ phone_href }}">
              <span class="mt-contact__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              </span>
              <span>Tlf.: {{ phone }}</span>
            </a>
          {% endif %}
          {% if email != blank %}
            <a class="mt-contact__link" href="mailto:{{ email }}">
              <span class="mt-contact__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </span>
              <span>{{ email }}</span>
            </a>
          {% endif %}
        </div>
      </div>

      <div class="mt-contact__form-wrap">
        {%- form 'contact', id: form_id, class: 'mt-contact__form' -%}
          {%- if form.posted_successfully? -%}
            <div class="form-status-list" role="status">
              <p class="form-message alert alert--success h6 flex gap-2">
                {% render 'icon', icon: 'check', size: 'small', class: 'shrink-0' %}
                {{ 'blocks.contact_form.post_success' | t }}
              </p>
            </div>
          {%- elsif form.errors -%}
            <div class="form-error alert alert--error">
              <p class="form-message form-message--error h6 flex gap-2" role="alert">
                {% render 'icon', icon: 'warning', size: 'small', class: 'shrink-0' %}
                {{ 'blocks.contact_form.error_heading' | t }}
              </p>
            </div>
          {%- endif -%}

          <div class="mt-contact__field">
            <label class="form-label" for="{{ form_id }}-name">
              {{ 'blocks.contact_form.name' | t }}
              <span class="form-required" aria-hidden="true">*</span>
            </label>
            <input
              class="form-control w-full"
              type="text"
              id="{{ form_id }}-name"
              name="contact[name]"
              autocomplete="name"
              required
              aria-required="true"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            >
          </div>

          <div class="mt-contact__row">
            <div class="mt-contact__field">
              <label class="form-label" for="{{ form_id }}-email">
                {{ 'blocks.contact_form.email' | t }}
                <span class="form-required" aria-hidden="true">*</span>
              </label>
              <input
                class="form-control w-full"
                type="email"
                id="{{ form_id }}-email"
                name="contact[email]"
                autocomplete="email"
                spellcheck="false"
                autocapitalize="off"
                required
                aria-required="true"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                {% endif %}
              >
            </div>
            <div class="mt-contact__field">
              <label class="form-label" for="{{ form_id }}-phone">{{ 'blocks.contact_form.phone' | t }}</label>
              <input
                class="form-control w-full"
                type="tel"
                id="{{ form_id }}-phone"
                name="contact[phone]"
                autocomplete="tel"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
              >
            </div>
          </div>

          <div class="mt-contact__field">
            <label class="form-label" for="{{ form_id }}-body">{{ 'blocks.contact_form.your_message' | t }}</label>
            <textarea
              class="form-control form-control--textarea w-full"
              id="{{ form_id }}-body"
              name="contact[body]"
              rows="6"
            >{%- if form.body -%}{{ form.body }}{%- endif -%}</textarea>
          </div>

          <button type="submit" class="btn btn--primary btn--icon-solid w-full mt-contact__submit">
            <span class="btn__text">{{ 'blocks.contact_form.send_message' | t }}</span>
          </button>
        {%- endform -%}

        <script>
          (function() {
            var form = document.getElementById('{{ form_id }}');
            if (!form) return;

            var nameInput = document.getElementById('{{ form_id }}-name');
            var emailInput = document.getElementById('{{ form_id }}-email');

            function resetCustom() {
              this.setCustomValidity('');
            }
            if (nameInput) nameInput.addEventListener('input', resetCustom);
            if (emailInput) emailInput.addEventListener('input', resetCustom);

            form.addEventListener('submit', function(e) {
              if (nameInput && !nameInput.value.trim()) {
                e.preventDefault();
                nameInput.setCustomValidity('Udfyld venligst dette felt');
                nameInput.reportValidity();
                nameInput.focus();
                return false;
              }

              if (emailInput && !emailInput.value.trim()) {
                e.preventDefault();
                emailInput.setCustomValidity('Udfyld venligst en gyldig e-mailadresse');
                emailInput.reportValidity();
                emailInput.focus();
                return false;
              }
            });
          })();
        </script>
      </div>
    </div>
  </div>
</div>

<style>
  #section-{{ section.id }}.mt-contact {
    padding: var(--mt-contact-pad-top) 0 var(--mt-contact-pad-bottom);
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }

  #section-{{ section.id }} .mt-contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.2rem;
    align-items: start;
  }

  #section-{{ section.id }} .mt-contact__heading {
    margin: 0 0 1.6rem;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight, 700);
    font-size: clamp(2.8rem, 4vw, 4.2rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  #section-{{ section.id }} .mt-contact__intro,
  #section-{{ section.id }} .mt-contact__text {
    font-family: var(--font-body--family);
    font-size: 1.6rem;
    line-height: 1.65;
  }

  #section-{{ section.id }} .mt-contact__intro p,
  #section-{{ section.id }} .mt-contact__text p {
    margin: 0 0 1.2rem;
  }

  #section-{{ section.id }} .mt-contact__intro p:last-child,
  #section-{{ section.id }} .mt-contact__text p:last-child {
    margin-bottom: 0;
  }

  #section-{{ section.id }} .mt-contact__block {
    margin-top: 2.4rem;
  }

  #section-{{ section.id }} .mt-contact__subheading {
    margin: 0 0 0.6rem;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight, 700);
    font-size: 1.8rem;
    line-height: 1.3;
  }

  #section-{{ section.id }} .mt-contact__info a,
  #section-{{ section.id }} .mt-contact__text a {
    color: var(--mt-contact-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  #section-{{ section.id }} .mt-contact__links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2rem;
  }

  #section-{{ section.id }} .mt-contact__link {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--mt-contact-accent);
    text-decoration: none;
    font-weight: 500;
  }

  #section-{{ section.id }} .mt-contact__icon {
    display: inline-flex;
    width: 1.8rem;
    height: 1.8rem;
    flex-shrink: 0;
  }

  #section-{{ section.id }} .mt-contact__icon svg {
    width: 100%;
    height: 100%;
  }

  #section-{{ section.id }} .mt-contact__form-wrap {
    background: rgb(var(--color-foreground) / 0.05);
    padding: 2.4rem;
    border-radius: 2rem;
  }

  #section-{{ section.id }} .mt-contact__form {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  #section-{{ section.id }} .mt-contact__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
  }

  #section-{{ section.id }} .mt-contact__field .form-label {
    margin-bottom: 0.6rem;
    font-size: 1.4rem;
    font-weight: 500;
  }

  #section-{{ section.id }} .form-required {
    color: #e03131;
    margin-inline-start: 0.25rem;
    font-weight: 600;
  }

  #section-{{ section.id }} .mt-contact__form .form-control {
    background: rgb(var(--color-background));
    border-radius: 0.8rem;
    border: 1px solid rgb(var(--color-border) / var(--color-border-alpha, 0.35));
    padding: 1.2rem 1.6rem;
    font-size: 1.5rem;
    line-height: 1.4;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  #section-{{ section.id }} .mt-contact__form .form-control:focus {
    border-color: var(--mt-contact-accent);
    outline: none;
    box-shadow: 0 0 0 1px var(--mt-contact-accent);
  }

  #section-{{ section.id }} .mt-contact__form textarea.form-control {
    min-height: 14rem;
    resize: vertical;
    border-radius: 0.8rem;
  }

  #section-{{ section.id }} .mt-contact__submit.btn--primary {
    text-transform: uppercase;
    letter-spacing: 0.04em;
    min-height: 5.2rem;
    justify-content: center;
    border-radius: 0.8rem;
  }

  @media (min-width: 750px) {
    #section-{{ section.id }} .mt-contact__grid {
      grid-template-columns: 1fr 1fr;
      gap: 6.4rem;
      align-items: start;
    }

    #section-{{ section.id }} .mt-contact__row {
      grid-template-columns: 1fr 1fr;
    }

    #section-{{ section.id }} .mt-contact__form-wrap {
      padding: 3.2rem;
    }
  }
</style>

{% schema %}
{
  "name": "Contact split",
  "tag": "section",
  "class": "section-mt-contact",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Vi er her for at hjælpe!"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>Hvis du har spørgsmål, store som små, eller har brug for mere information om vores produkter, tøv endelig ikke med at kontakte os. Vores team står klar til at hjælpe dig, så du får den bedste oplevelse og de svar, du søger.</p><p>Vi glæder os til at høre fra dig!</p>"
    },
    {
      "type": "text",
      "id": "returns_heading",
      "label": "Returns heading",
      "default": "Returnering eller reklamation"
    },
    {
      "type": "richtext",
      "id": "returns_text",
      "label": "Returns text",
      "default": "<p>Skal du returnere eller reklamere over et produkt kan du gå direkte her til vores <a href=\"/pages/returnering\">returportal</a> eller vores <a href=\"/pages/reklamation\">reklamationsside</a>.</p>"
    },
    {
      "type": "text",
      "id": "company",
      "label": "Company name",
      "default": "Martilness"
    },
    {
      "type": "richtext",
      "id": "address",
      "label": "Address",
      "default": "<p>Baunebakkevej 12, 2.th<br/>2650 Hvidovre<br/>CVR: 35633146</p>"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "+45 2779 6900"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "info@martilness.dk"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Link and button color",
      "default": "#09412d"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Contact split"
    }
  ]
}
{% endschema %}
