{%- liquid
  assign group_titles = 'CBD Topskud,CBD Hash,CBD Olie,THCA' | split: ','
  assign card_scheme = section.settings.card_color_scheme
  assign heading_tag = 'h2'
  if section.settings.use_h1
    assign heading_tag = 'h1'
  endif
-%}

<style>
  #section-{{ section.id }} .fr-certs__inner {
    display: flex;
    flex-direction: column;
    gap: 5.6rem;
  }

  /* ---------- Intro ---------- */
  #section-{{ section.id }} .fr-certs__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.6rem;
  }
  #section-{{ section.id }} .fr-certs__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.6rem 1.4rem;
    border-radius: 99px;
    border: 0.1rem solid rgb(var(--color-border) / var(--color-border-alpha));
    font-size: 1.3rem;
    font-weight: 500;
    color: rgb(var(--color-foreground) / 0.7);
  }
  #section-{{ section.id }} .fr-certs__eyebrow::before {
    content: "";
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: rgb(var(--color-foreground));
  }
  #section-{{ section.id }} .fr-certs__title {
    margin: 0;
    max-width: 18ch;
    text-wrap: balance;
  }
  #section-{{ section.id }} .fr-certs__lead {
    margin: 0;
    max-width: 56ch;
    color: rgb(var(--color-foreground) / 0.72);
    text-wrap: pretty;
  }

  /* ---------- Group ---------- */
  #section-{{ section.id }} .fr-certs__group {
    display: flex;
    flex-direction: column;
    gap: 2.4rem;
  }
  #section-{{ section.id }} .fr-certs__group-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.2rem;
    padding-bottom: 1.6rem;
    border-bottom: 0.1rem solid rgb(var(--color-border) / var(--color-border-alpha));
  }
  #section-{{ section.id }} .fr-certs__group-title {
    margin: 0;
  }
  #section-{{ section.id }} .fr-certs__count {
    font-size: 1.3rem;
    font-weight: 500;
    color: rgb(var(--color-foreground) / 0.6);
    white-space: nowrap;
  }

  /* ---------- Grid ---------- */
  #section-{{ section.id }} .fr-certs__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media screen and (min-width: 640px) {
    #section-{{ section.id }} .fr-certs__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media screen and (min-width: 1024px) {
    #section-{{ section.id }} .fr-certs__grid { grid-template-columns: repeat(3, 1fr); gap: 2.4rem; }
  }

  /* ---------- Card ---------- */
  #section-{{ section.id }} .fr-certs__card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--product-card-media-radius, 1.2rem);
    border: 0.1rem solid rgb(var(--color-border) / var(--color-border-alpha));
    background-color: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    transition: transform var(--animation-duration--medium, 0.3s) var(--animation-easing);
  }
  @media (hover: hover) and (pointer: fine) {
    #section-{{ section.id }} .fr-certs__card:hover { transform: translateY(-0.3rem); }
    #section-{{ section.id }} .fr-certs__card:hover .fr-certs__media img { transform: scale(1.04); }
  }
  #section-{{ section.id }} .fr-certs__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  #section-{{ section.id }} .fr-certs__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--animation-duration--slow, 0.5s) var(--animation-easing);
  }
  /* Kort uden billede endnu — neutralt felt frem for brudt billede */
  #section-{{ section.id }} .fr-certs__media--empty {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgb(var(--color-foreground) / 0.05);
  }
  #section-{{ section.id }} .fr-certs__media--empty span {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground) / 0.35);
  }
  #section-{{ section.id }} .fr-certs__badge {
    position: absolute;
    inset-block-start: 1.2rem;
    inset-inline-start: 1.2rem;
    padding: 0.5rem 1.2rem;
    border-radius: var(--badge-corner-radius, 99px);
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  #section-{{ section.id }} .fr-certs__body {
    padding: 2rem 2rem 0;
  }
  #section-{{ section.id }} .fr-certs__name {
    margin: 0 0 1.2rem;
    text-wrap: balance;
  }
  #section-{{ section.id }} .fr-certs__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.2rem;
    padding: 1rem 0;
    border-bottom: 0.1rem solid rgb(var(--color-border) / var(--color-border-alpha));
    font-size: 1.3rem;
  }
  #section-{{ section.id }} .fr-certs__row:last-child { border-bottom: 0; }
  #section-{{ section.id }} .fr-certs__label {
    flex-shrink: 0;
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground) / 0.6);
  }
  #section-{{ section.id }} .fr-certs__value {
    font-weight: 600;
    text-align: end;
  }
  #section-{{ section.id }} .fr-certs__value--accent { font-size: 1.5rem; }
  #section-{{ section.id }} .fr-certs__actions {
    margin-top: auto;
    padding: 1.6rem 2rem 2rem;
  }
  #section-{{ section.id }} .fr-certs__actions .btn { width: 100%; }

  /* ---------- Info band ---------- */
  #section-{{ section.id }} .fr-certs__info {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.4rem;
    padding: 4.8rem 2.4rem;
    border-radius: var(--product-card-media-radius, 1.2rem);
    background-color: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }
  #section-{{ section.id }} .fr-certs__info-label {
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground) / 0.7);
  }
  #section-{{ section.id }} .fr-certs__info-title { margin: 0; max-width: 22ch; text-wrap: balance; }
  #section-{{ section.id }} .fr-certs__info p { margin: 0; max-width: 50ch; color: rgb(var(--color-foreground) / 0.8); }
  @media screen and (min-width: 750px) {
    #section-{{ section.id }} .fr-certs__info { padding: 5.6rem 3.2rem; }
  }

  /* ---------- CTA ---------- */
  #section-{{ section.id }} .fr-certs__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.6rem;
  }
  #section-{{ section.id }} .fr-certs__cta-title { margin: 0; max-width: 16ch; text-wrap: balance; }
  #section-{{ section.id }} .fr-certs__cta p { margin: 0; max-width: 50ch; color: rgb(var(--color-foreground) / 0.72); }
  #section-{{ section.id }} .fr-certs__cta-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.2rem;
    margin-top: 0.8rem;
  }
</style>

<div
  id="section-{{ section.id }}"
  class="section section--analysecertifikater spacing-style color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="page-width">
    <div class="fr-certs__inner">
      {%- comment -%} Intro {%- endcomment -%}
      <div class="fr-certs__intro">
        {%- if section.settings.eyebrow != blank -%}
          <span class="fr-certs__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <{{ heading_tag }} class="fr-certs__title h1">{{ section.settings.heading }}</{{ heading_tag }}>
        {%- endif -%}
        {%- if section.settings.lead != blank -%}
          <p class="fr-certs__lead">{{ section.settings.lead }}</p>
        {%- endif -%}
      </div>

      {%- comment -%} Grupper {%- endcomment -%}
      {%- for group_title in group_titles -%}
        {%- liquid
          case forloop.index0
            when 0
              assign rows = certs_flower | strip | split: ';;'
            when 1
              assign rows = certs_hash | strip | split: ';;'
            when 2
              assign rows = certs_oil | strip | split: ';;'
            when 3
              assign rows = certs_thca | strip | split: ';;'
          endcase
        -%}

        <section class="fr-certs__group">
          <div class="fr-certs__group-head">
            <h2 class="fr-certs__group-title h3">{{ group_title | strip }}</h2>
            <span class="fr-certs__count">{{ rows.size }} certifikater</span>
          </div>

          <div class="fr-certs__grid">
            {%- for row in rows -%}
              {%- liquid
                assign cert = row | strip | split: '|'
                assign cert_name = cert[0] | strip
                assign cert_batch = cert[1] | strip
                assign cert_lab = cert[2] | strip
                assign cert_key_label = cert[3] | strip
                assign cert_key_value = cert[4] | strip
                assign cert_thc = cert[5] | strip
                assign cert_image = cert[6] | strip
                assign cert_pdf = cert[7] | strip
              -%}
              <article class="fr-certs__card color-{{ card_scheme }}">
                {%- if cert_image == '-' -%}
                  <div class="fr-certs__media fr-certs__media--empty">
                    <span>{{ cert_key_label }}</span>
                    <span class="fr-certs__badge">COA</span>
                  </div>
                {%- else -%}
                  <div class="fr-certs__media">
                    {%- comment -%}
                      Billederne ligger i Files, ikke som image_url-objekter, så CDN'et
                      skaleres via &width= — samme mønster som i hero-sektionen.
                    {%- endcomment -%}
                    <img
                      src="{{ cert_image }}&width=600"
                      srcset="{{ cert_image }}&width=400 400w, {{ cert_image }}&width=600 600w, {{ cert_image }}&width=900 900w"
                      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                      alt="{{ cert_name }} — analysecertifikat"
                      loading="lazy"
                      decoding="async"
                    >
                    <span class="fr-certs__badge">COA</span>
                  </div>
                {%- endif -%}

                <div class="fr-certs__body">
                  <h3 class="fr-certs__name h5">{{ cert_name }}</h3>

                  <div class="fr-certs__row">
                    <span class="fr-certs__label">Batch</span>
                    <span class="fr-certs__value">{{ cert_batch }}</span>
                  </div>
                  <div class="fr-certs__row">
                    <span class="fr-certs__label">Laboratorium</span>
                    <span class="fr-certs__value">{{ cert_lab }}</span>
                  </div>
                  <div class="fr-certs__row">
                    <span class="fr-certs__label">{{ cert_key_label }}</span>
                    <span class="fr-certs__value fr-certs__value--accent">{{ cert_key_value }}</span>
                  </div>
                  <div class="fr-certs__row">
                    <span class="fr-certs__label">Δ9-THC</span>
                    <span class="fr-certs__value">{{ cert_thc }}</span>
                  </div>
                </div>

                <div class="fr-certs__actions">
                  {% render 'button',
                    label: 'Se PDF',
                    link: cert_pdf,
                    style: 'primary',
                    size: 'medium',
                    icon: 'arrow-right',
                    icon_style: 'solid',
                    attributes: 'target="_blank" rel="noopener"',
                    with_wrapper: false
                  %}
                </div>
              </article>
            {%- endfor -%}
          </div>
        </section>
      {%- endfor -%}

      {%- comment -%} Info-bånd {%- endcomment -%}
      {%- if section.settings.info_title != blank -%}
        <div class="fr-certs__info color-{{ section.settings.info_color_scheme }}">
          {%- if section.settings.info_label != blank -%}
            <span class="fr-certs__info-label">{{ section.settings.info_label }}</span>
          {%- endif -%}
          <h2 class="fr-certs__info-title h2">{{ section.settings.info_title }}</h2>
          {%- if section.settings.info_text != blank -%}
            <p>{{ section.settings.info_text }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} CTA {%- endcomment -%}
      {%- if section.settings.cta_title != blank -%}
        <div class="fr-certs__cta">
          <h2 class="fr-certs__cta-title h2">{{ section.settings.cta_title }}</h2>
          {%- if section.settings.cta_text != blank -%}
            <p>{{ section.settings.cta_text }}</p>
          {%- endif -%}
          <div class="fr-certs__cta-buttons">
            {% render 'button',
              label: section.settings.cta_primary_label,
              link: section.settings.cta_primary_link,
              style: 'primary',
              size: 'large',
              icon: 'arrow-right',
              icon_style: 'solid',
              with_wrapper: false
            %}
            {% render 'button',
              label: section.settings.cta_secondary_label,
              link: section.settings.cta_secondary_link,
              style: 'secondary',
              size: 'large',
              with_wrapper: false
            %}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

