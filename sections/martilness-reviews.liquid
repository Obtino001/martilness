{%- liquid
  assign heading = section.settings.heading | default: 'Vi samler på glade kunder'
  assign rating_label = section.settings.rating_label | default: '4,8 ud af 5 stjerner på Trustpilot'
  assign link_label = section.settings.link_label
  assign link_url = section.settings.link_url
  assign speed = section.settings.marquee_speed | default: 40
  assign pause_on_hover = section.settings.pause_on_hover
-%}

<div
  id="section-{{ section.id }}"
  class="mt-reviews color-{{ section.settings.color_scheme }}"
  style="
    --mt-reviews-pad-top: {{ section.settings.padding_top }}px;
    --mt-reviews-pad-bottom: {{ section.settings.padding_bottom }}px;
    --mt-marquee-duration: {{ speed }}s;
  "
>
  <div class="mt-reviews__inner">
    <div class="mt-reviews__header page-width">
      {% if heading != blank %}
        <h2 class="mt-reviews__heading">{{ heading }}</h2>
      {% endif %}
      {% if rating_label != blank %}
        <div class="mt-reviews__rating">
          <span class="mt-reviews__stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 24 24" focusable="false"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            {%- endfor -%}
          </span>
          <span class="mt-reviews__rating-text">{{ rating_label }}</span>
        </div>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div
        class="mt-reviews__marquee{% if pause_on_hover %} mt-reviews__marquee--pause{% endif %}"
        role="region"
        aria-label="{{ heading | escape }}"
      >
        <div class="mt-reviews__track">
          {%- for pass in (1..2) -%}
            <div class="mt-reviews__group" {% if pass == 2 %}aria-hidden="true"{% endif %}>
              {% for block in section.blocks %}
                <article class="mt-reviews__card" {% if pass == 1 %}{{ block.shopify_attributes }}{% endif %}>
                  <div class="mt-reviews__card-stars" aria-hidden="true">
                    {%- for i in (1..5) -%}
                      <svg viewBox="0 0 24 24" focusable="false"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    {%- endfor -%}
                  </div>
                  {% if block.settings.title != blank %}
                    <h3 class="mt-reviews__card-title">{{ block.settings.title }}</h3>
                  {% endif %}
                  {% if block.settings.text != blank %}
                    <p class="mt-reviews__card-text">{{ block.settings.text }}</p>
                  {% endif %}
                  {% if block.settings.author != blank %}
                    <p class="mt-reviews__card-author">- {{ block.settings.author }}</p>
                  {% endif %}
                </article>
              {% endfor %}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {% endif %}

    {% if link_label != blank %}
      <div class="mt-reviews__footer page-width">
        <a
          class="mt-reviews__link"
          href="{{ link_url | default: 'https://dk.trustpilot.com' }}"
          {% if link_url contains 'http' %}target="_blank" rel="noopener"{% endif %}
        >
          {{ link_label }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

<style>
  #section-{{ section.id }}.mt-reviews {
    padding: var(--mt-reviews-pad-top) 0 var(--mt-reviews-pad-bottom);
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    overflow: hidden;
  }

  #section-{{ section.id }} .mt-reviews__header,
  #section-{{ section.id }} .mt-reviews__footer {
    max-width: var(--page-width, 120rem);
    margin-inline: auto;
    padding-inline: var(--page-padding, 2rem);
  }

  #section-{{ section.id }} .mt-reviews__header {
    text-align: center;
    margin-bottom: 4rem;
  }

  #section-{{ section.id }} .mt-reviews__heading {
    margin: 0 0 1.2rem;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight, 700);
    font-size: clamp(2.8rem, 4vw, 4.2rem);
    line-height: 1.15;
  }

  #section-{{ section.id }} .mt-reviews__rating {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  #section-{{ section.id }} .mt-reviews__stars,
  #section-{{ section.id }} .mt-reviews__card-stars {
    display: inline-flex;
    gap: 0.25rem;
  }

  #section-{{ section.id }} .mt-reviews__stars svg,
  #section-{{ section.id }} .mt-reviews__card-stars svg {
    width: 1.8rem;
    height: 1.8rem;
    fill: #00b67a;
    display: block;
  }

  #section-{{ section.id }} .mt-reviews__rating-text {
    font-size: 1.5rem;
    font-weight: 500;
  }

  #section-{{ section.id }} .mt-reviews__marquee {
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent);
  }

  #section-{{ section.id }} .mt-reviews__track {
    display: flex;
    width: max-content;
    animation: mt-reviews-marquee-{{ section.id }} var(--mt-marquee-duration) linear infinite;
    will-change: transform;
  }

  #section-{{ section.id }} .mt-reviews__marquee--pause:hover .mt-reviews__track {
    animation-play-state: paused;
  }

  #section-{{ section.id }} .mt-reviews__group {
    display: flex;
    gap: 2rem;
    padding-inline-end: 2rem;
  }

  #section-{{ section.id }} .mt-reviews__card {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    flex: 0 0 auto;
    width: min(32rem, 78vw);
    padding: 2rem;
    border-radius: 1.6rem;
    background: rgb(var(--color-background));
    border: 1px solid rgb(var(--color-foreground) / 0.08);
    box-sizing: border-box;
  }

  #section-{{ section.id }} .mt-reviews__card-title {
    margin: 0;
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.3;
  }

  #section-{{ section.id }} .mt-reviews__card-text {
    margin: 0;
    font-size: 1.45rem;
    line-height: 1.5;
    color: rgb(var(--color-foreground) / 0.82);
  }

  #section-{{ section.id }} .mt-reviews__card-author {
    margin: 0.4rem 0 0;
    font-size: 1.4rem;
    color: rgb(var(--color-foreground) / 0.7);
  }

  #section-{{ section.id }} .mt-reviews__footer {
    margin-top: 3.2rem;
    text-align: center;
  }

  #section-{{ section.id }} .mt-reviews__link {
    font-size: 1.5rem;
    font-weight: 600;
    color: rgb(var(--color-foreground));
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  @keyframes mt-reviews-marquee-{{ section.id }} {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    #section-{{ section.id }} .mt-reviews__track {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
      justify-content: center;
      max-width: var(--page-width, 120rem);
      margin-inline: auto;
      padding-inline: var(--page-padding, 2rem);
    }

    #section-{{ section.id }} .mt-reviews__group:last-child {
      display: none;
    }

    #section-{{ section.id }} .mt-reviews__group {
      flex-wrap: wrap;
      justify-content: center;
      padding-inline-end: 0;
    }
  }
</style>

{% schema %}
{
  "name": "Trustpilot reviews",
  "tag": "section",
  "class": "section-martilness-reviews",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Vi samler på glade kunder"
    },
    {
      "type": "text",
      "id": "rating_label",
      "label": "Trustpilot rating text",
      "default": "4,8 ud af 5 stjerner på Trustpilot"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Marquee speed",
      "min": 15,
      "max": 80,
      "step": 5,
      "unit": "s",
      "default": 40,
      "info": "Lower = faster"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Footer link label",
      "default": "Se flere anmeldelser her →"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Footer link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "God kvalitet"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review text",
          "default": "Hurtig levering og god kvalitet af varen."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Anders Hein"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trustpilot reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "title": "God kvalitet af...",
            "text": "Hurtig levering og god kvalitet af varen. Mangler dog en brugsvejledning men ellers fint.",
            "author": "Anders Hein"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Alt var perfekt",
            "text": "Bestilte infrarødt saunatæppe. Virkelig godt produkt og varen ankom hurtigt.",
            "author": "Lene"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Jeg er tilfreds med købet",
            "text": "Jeg er tilfreds med købet, også for at prøve noget nyt og se hvad der sker.",
            "author": "Adam Sebastian Nielsen"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Saunatæppet er fantastisk!",
            "text": "Saunatæppet er fantastisk! Prisen er langt lavere end andre steder, men kvaliteten er helt i top 💪",
            "author": "Ronni Iversen"
          }
        }
      ]
    }
  ]
}
{% endschema %}
