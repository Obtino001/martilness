{%- liquid
  assign enable_country_selector = false
  if section.settings.enable_country_selector and localization.available_countries.size > 1
    assign enable_country_selector = true
  endif

  assign enable_language_selector = false
  if section.settings.enable_language_selector and localization.available_languages.size > 1
    assign enable_language_selector = true
  endif

  assign enable_social_media_icons = false
  if section.settings.enable_social_media_icons
    assign socials = 'facebook,instagram,tiktok,pinterest,x,threads,youtube,vimeo,snapchat,linkedin,tumblr'
    assign socials_arr = socials | split: ','

    for social in socials_arr
      assign setting_key = social | append: '_url'
      if settings[setting_key] != blank
        assign enable_social_media_icons = true
        break
      endif
    endfor
  endif

  assign enable_follow_on_shop = false
  if section.settings.enable_follow_on_shop and shop.features.follow_on_shop?
    assign enable_follow_on_shop = true
  endif

  assign enable_payment_icons = section.settings.enable_payment_icons
%}
{%- capture inline_style -%}
  {% render 'spacing-style', settings: section.settings %}
{%- endcapture -%}
<footer
  class="footer block color-{{ section.settings.color_scheme }}"
  style="{% render 'border-style', settings: section.settings %}"
>
  <div
    class="footer__top spacing-style"
    style="{{ inline_style | strip | strip_newlines }}"
  >
    <div class="page-width">
      <div class="footer__top-blocks flex flex-wrap">
        {%- content_for 'blocks' -%}
      </div>
    </div>
  </div>
  <div class="footer__bottom page-width">
    {%- if section.settings.show_footer_bar -%}
      <div class="footer__bar">
        <div class="footer__bar-col">
          <span class="footer__bar-label h5">{{ section.settings.payment_label | default: 'Betalingsmuligheder' }}</span>
          <div class="footer__bar-icons">
            {%- assign footer_payment_methods = 'dankort,visa,master,apple_pay,mobilepay,google_pay' | split: ',' -%}
            {%- for method in footer_payment_methods -%}
              {%- render 'martilness-payment-icon', type: method -%}
            {%- endfor -%}
          </div>
        </div>
        <div class="footer__bar-col">
          <span class="footer__bar-label h5">{{ section.settings.shipping_label | default: 'Fragtpartner' }}</span>
          {%- if section.settings.shipping_image != blank -%}
            <img
              class="footer__bar-shipping"
              src="{{ section.settings.shipping_image | image_url: width: 160 }}"
              alt="{{ section.settings.shipping_label | default: 'Fragtpartner' }} — GLS"
              loading="lazy"
              width="{{ section.settings.shipping_image.width }}"
              height="{{ section.settings.shipping_image.height }}"
            >
          {%- else -%}
            <img
              class="footer__bar-shipping"
              src="{{ 'gls-logo.svg' | asset_url }}"
              alt="GLS"
              loading="lazy"
              width="140"
              height="49"
            >
          {%- endif -%}
        </div>
        {%- assign reviews_url = section.settings.reviews_url | default: 'https://dk.trustpilot.com/review/martilness.dk' -%}
        <a
          href="{{ reviews_url }}"
          class="footer__bar-col footer__bar-col--link text-decoration-none color-current"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="{{ section.settings.reviews_label | default: 'Anmeldelser' }} - Trustpilot"
        >
          <span class="footer__bar-label h5">{{ section.settings.reviews_label | default: 'Anmeldelser' }}</span>
          <div class="footer__bar-stars">
            {%- for i in (1..5) -%}
              <span class="footer__bar-star"><svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></span>
            {%- endfor -%}
          </div>
        </a>
      </div>
    {%- endif -%}
    {%- if section.settings.menu != blank -%}
      <div class="footer__bottom-row flex flex-wrap gap-5 md:gap-6 justify-between items-end">
        <ul class="footer__links list-unstyled flex flex-wrap gap-1 gap-x-3 md:gap-x-6">
          {%- for link in section.settings.menu.links -%}
            <li>
              <a href="{{ link.url }}" class="reversed-link block">{{ link.title }}</a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
    <div class="footer__bottom-row flex flex-wrap gap-5 md:gap-6 justify-between items-center">
      <div class="footer__copyright text-wrap">
  &copy; {{ 'now' | date: '%Y' }}
  <a href="{{ routes.root_url }}">Martilness.dk</a>
  &middot; CVR 35633146
</div>
      {%- if enable_social_media_icons or enable_country_selector or enable_language_selector or enable_payment_icons or enable_follow_on_shop -%}
        <div class="flex flex-wrap items-center justify-end gap-5 md:gap-6">
          {%- if enable_follow_on_shop -%}
            <div class="footer__follow-on-shop">
              {% comment %} TODO: enable theme-check once `login_button` is accepted as valid filter {% endcomment %}
              {% # theme-check-disable %}
              {{ shop | login_button: action: 'follow' }}
              {% # theme-check-enable %}
            </div>
          {%- endif -%}
          {%- if enable_country_selector or enable_language_selector -%}
            {%- render 'dropdown-localization',
              block_id: section.id,
              toggle_button_style: 'outline',
              show_country: enable_country_selector,
              show_country_flag: true,
              show_language: enable_language_selector
            -%}
          {%- endif -%}

          {%- if enable_payment_icons -%}
            <div class="footer__payment">
              {%- render 'payment-icons' -%}
            </div>
          {%- endif -%}

          {%- if enable_social_media_icons -%}
            {% render 'social-icons', icon_type: 'solid' %}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>
{% stylesheet %}
/* ---- Footer bar: betaling / fragt / anmeldelser ---- */
.footer__bar {
  display: flex;
  align-items: stretch;
  gap: 2.4rem;
  padding-block: 1.8rem;
  border-block-start: 0.1rem solid rgb(var(--color-border) / var(--color-border-alpha));
}
.footer__bar-col {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 1rem;
  text-align: center;
}
a.footer__bar-col {
  text-decoration: none;
  color: inherit;
  cursor: pointer;
  transition: opacity var(--animation-duration--fast) var(--animation-easing);
}
a.footer__bar-col:hover {
  opacity: 0.82;
}
.footer__bar-col:not(:last-child) {
  border-inline-end: 0.1rem solid rgb(var(--color-border) / var(--color-border-alpha));
}
.footer__bar-label {
  margin: 0;
}
.footer__bar-icons {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
}
.footer__bar-icons svg {
  display: block;
  width: 3.8rem;
  height: 2.4rem;
}
.footer__bar-shipping {
  display: block;
  width: 9rem;
  max-width: 100%;
  height: auto;
}
.footer__bar-stars {
  display: flex;
  gap: 0.3rem;
}
.footer__bar-star {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 1.6rem;
  height: 1.6rem;
  background: #48bb78;
  border-radius: 0.4rem;
}
.footer__bar-star svg {
  display: block;
  width: 1rem;
  height: 1rem;
  fill: #fff;
}

/* ---- Email-felt: 8px afrundet kant ---- */
.footer .newsletter-form__field,
.footer .newsletter-form__input {
  border-radius: 0.8rem;
}

/* ---- Ikke-collapsible kolonne (nyhedsbrev): indhold synligt, header ikke klikbar ---- */
.footer div.footer__details .accordion__content {
  max-height: none;
}
.footer div.footer__details .accordion__summary {
  pointer-events: none;
}

/* ---- Bund-omraade: strammere afstande ---- */
.footer .footer__bottom {
  padding-top: 1.6rem;
}
.footer .footer__bottom-row {
  padding-block-end: 1.6rem;
}

@media (min-width: 1024px) {
  /* Taettere kolonne-headers: fjern min-height-luft over menuerne */
  .footer .footer__details .accordion__summary {
    min-height: 0;
    padding-block: 0 1.4rem;
    align-items: flex-start;
  }
  /* Balanceret copyright-padding */
  .footer .footer__bottom-row:last-child {
    padding-block: 1.8rem 2.4rem;
  }
}

@media (max-width: 767.98px) {
  /* Bar stables som kolonnerne: venstrestillet, vandrette dividers */
  .footer__bar {
    flex-direction: column;
    gap: 0;
    padding-block: 0;
    border-block-start: none;
  }
  .footer__bar-col {
    align-items: flex-start;
    text-align: left;
    padding-block: 1.6rem;
  }
  .footer__bar-col:not(:last-child) {
    border-inline-end: none;
    border-block-end: 0.1rem solid rgb(var(--color-border) / var(--color-border-alpha));
  }
  .footer__bar-icons,
  .footer__bar-stars {
    justify-content: flex-start;
  }
  /* Stram gab op til baren */
  .footer .footer__bottom {
    padding-top: 0;
  }
  .footer .footer__bar-col:first-child {
    padding-block-start: 0.4rem;
  }
  /* Copyright + social: venstrestillet, stablet, divider over */
  .footer .footer__bottom-row:last-child {
    flex-direction: column;
    align-items: flex-start;
    gap: 1.6rem;
    text-align: left;
    border-top: 0.1rem solid rgb(var(--color-border) / var(--color-border-alpha));
    padding-top: 2rem;
  }
  .footer .footer__bottom-row:last-child > * {
    width: auto;
  }
  .footer .footer__bottom-row:last-child > div:last-child {
    justify-content: flex-start;
  }
}
{% endstylesheet %}
{% schema %}
{
  "name": "t:names.footer",
  "settings": [
    {
      "type": "paragraph",
      "content": "[Read How-to](https://go.foxecom.com/QV7hJTv)"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:settings.menu"
    },
    {
      "type": "checkbox",
      "id": "enable_follow_on_shop",
      "label": "t:settings.enable_follow_on_shop",
      "info": "t:info.enable_follow_on_shop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_social_media_icons",
      "label": "t:settings.enable_social_media_icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "t:settings.enable_language_selector",
      "info": "t:info.enable_language_selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "t:settings.enable_country_selector",
      "info": "t:info.enable_country_selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_payment_icons",
      "label": "t:settings.enable_payment_icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Footer bar (betaling, fragt, anmeldelser)"
    },
    {
      "type": "checkbox",
      "id": "show_footer_bar",
      "label": "Vis footer bar",
      "default": true
    },
    {
      "type": "text",
      "id": "payment_label",
      "label": "Betalings-label",
      "default": "Betalingsmuligheder"
    },
    {
      "type": "text",
      "id": "shipping_label",
      "label": "Fragt-label",
      "default": "Fragtpartner"
    },
    {
      "type": "image_picker",
      "id": "shipping_image",
      "label": "Fragt-logo (fx GLS)"
    },
    {
      "type": "text",
      "id": "reviews_label",
      "label": "Anmeldelser-label",
      "default": "Anmeldelser"
    },
    {
      "type": "url",
      "id": "reviews_url",
      "label": "Anmeldelser-link"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.borders",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "unit": "px",
      "label": "t:settings.border_width",
      "default": 1,
      "visible_if": "{{ section.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.border_opacity",
      "default": 100,
      "visible_if": "{{ section.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "select",
      "id": "device",
      "label": "t:settings.devices",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80,
      "visible_if": "{{ section.settings.device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.device == 'mobile' }}"
    }
  ],
  "blocks": [
    {
      "type": "_footer-column"
    }
  ]
}
{% endschema %}
