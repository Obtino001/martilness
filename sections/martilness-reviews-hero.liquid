{%- liquid
  assign overlay_text = section.settings.overlay_text | default: 'Danskere elsker vores velvære'
  assign accent = section.settings.accent_color | default: '#09412d'
-%}

<div
  id="section-{{ section.id }}"
  class="mt-reviews-hero color-{{ section.settings.color_scheme }}"
  style="--mt-reviews-hero-accent: {{ accent }}; --mt-reviews-hero-height: {{ section.settings.image_height }}px;"
>
  <div class="mt-reviews-hero__media">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="mt-reviews-hero__cell" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {%- assign image_alt = block.settings.image.alt | default: overlay_text -%}
            {%- if forloop.first -%}
              {%- assign image_loading = 'eager' -%}
            {%- else -%}
              {%- assign image_loading = 'lazy' -%}
            {%- endif -%}
            {{
              block.settings.image
              | image_url: width: 900
              | image_tag:
                loading: image_loading,
                widths: '240, 360, 480, 720, 900',
                sizes: '(min-width: 990px) 20vw, 50vw',
                alt: image_alt,
                class: 'mt-reviews-hero__image'
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'mt-reviews-hero__image mt-reviews-hero__image--placeholder' }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..5) -%}
        <div class="mt-reviews-hero__cell">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'mt-reviews-hero__image mt-reviews-hero__image--placeholder' }}
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if overlay_text != blank -%}
    <div class="mt-reviews-hero__overlay">
      {%- if section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="btn btn--primary mt-reviews-hero__button">{{ overlay_text }}</a>
      {%- else -%}
        <span class="btn btn--primary mt-reviews-hero__button">{{ overlay_text }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

<style>
  #section-{{ section.id }}.mt-reviews-hero {
    position: relative;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }

  #section-{{ section.id }} .mt-reviews-hero__media {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.4rem;
    min-height: calc(var(--mt-reviews-hero-height) * 0.72);
  }

  #section-{{ section.id }} .mt-reviews-hero__cell {
    min-height: 22rem;
    overflow: hidden;
    background: rgb(var(--color-foreground) / 0.06);
  }

  #section-{{ section.id }} .mt-reviews-hero__cell:nth-child(n + 5) {
    display: none;
  }

  #section-{{ section.id }} .mt-reviews-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #section-{{ section.id }} .mt-reviews-hero__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 2rem;
    padding-bottom: 3.5rem;
    pointer-events: none;
  }

  #section-{{ section.id }} .mt-reviews-hero__button {
    pointer-events: auto;
    font-family: var(--font-heading--family);
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    padding: 1.2rem 2.4rem;
  }



  @media (min-width: 750px) {
    #section-{{ section.id }} .mt-reviews-hero__media {
      grid-template-columns: repeat(5, 1fr);
      min-height: var(--mt-reviews-hero-height);
    }

    #section-{{ section.id }} .mt-reviews-hero__cell {
      min-height: var(--mt-reviews-hero-height);
    }

    #section-{{ section.id }} .mt-reviews-hero__cell:nth-child(n + 5) {
      display: block;
    }

    #section-{{ section.id }} .mt-reviews-hero__cell:nth-child(n + 6) {
      display: none;
    }

    #section-{{ section.id }} .mt-reviews-hero__button {
      padding: 1.4rem 3.2rem;
    }
  }
</style>

{% schema %}
{
  "name": "Reviews photo hero",
  "tag": "section",
  "class": "section-mt-reviews-hero",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "textarea",
      "id": "overlay_text",
      "label": "Button text",
      "default": "Danskere elsker vores velvære"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Overlay border",
      "default": "#09412d"
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Photo height",
      "min": 280,
      "max": 560,
      "step": 10,
      "unit": "px",
      "default": 420
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews photo hero",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
