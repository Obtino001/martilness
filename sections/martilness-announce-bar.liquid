{%- liquid
  assign bg = section.settings.background | default: '#09412d'
  assign fg = section.settings.text_color | default: '#ffffff'
-%}

<div
  id="section-{{ section.id }}"
  class="mt-announce-bar"
  style="
    --mt-announce-bg: {{ bg }};
    --mt-announce-fg: {{ fg }};
  "
>
  <div class="mt-announce-bar__inner page-width">
    <ul class="mt-announce-bar__list" role="list">
      {%- for block in section.blocks -%}
        {%- if block.settings.text != blank -%}
          <li class="mt-announce-bar__item" {{ block.shopify_attributes }}>
            <span class="mt-announce-bar__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'truck' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1.5 7.5h12.5v8H1.5z"/>
                    <path d="M14 10.5h3.6L20.5 13v2.5H14v-5z"/>
                    <circle cx="6" cy="17.5" r="1.6"/>
                    <circle cx="17" cy="17.5" r="1.6"/>
                    <path d="M3.5 17.5h1M8.2 17.5H14"/>
                  </svg>
                {%- when 'dolly' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5.5 3.5v13.5"/>
                    <path d="M5.5 17h11l2.8-6.5H8.5"/>
                    <rect x="8.2" y="7.2" width="7.2" height="4.4"/>
                    <circle cx="5.5" cy="19.2" r="1.8"/>
                  </svg>
                {%- when 'return' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 12a8 8 0 1 0 2.3-5.7"/>
                    <path d="M4 4.5V9h4.5"/>
                  </svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2.4l2.6 6.3 6.8.6-5.2 4.3 1.6 6.6L12 16.8 6.2 20.2l1.6-6.6-5.2-4.3 6.8-.6L12 2.4z"/>
                  </svg>
              {%- endcase -%}
            </span>
            {%- liquid
              assign item_link = block.settings.link
              assign item_text_down = block.settings.text | downcase
              if item_link == blank and item_text_down contains 'trustpilot'
                assign item_link = 'https://dk.trustpilot.com/review/martilness.dk'
              endif
            -%}
            {%- if item_link != blank -%}
              <a class="mt-announce-bar__text text-decoration-none color-current" href="{{ item_link }}" {% if item_link contains 'http' %}target="_blank" rel="noopener noreferrer"{% endif %}>{{ block.settings.text }}</a>
            {%- else -%}
              <span class="mt-announce-bar__text">{{ block.settings.text }}</span>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</div>

<style>
  #section-{{ section.id }}.mt-announce-bar {
    background: var(--mt-announce-bg);
    color: var(--mt-announce-fg);
    padding: 1rem var(--page-padding, 1.6rem);
  }

  #section-{{ section.id }} .mt-announce-bar__inner {
    max-width: var(--page-width, 1500px);
    margin: 0 auto;
  }

  #section-{{ section.id }} .mt-announce-bar__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.4rem 4rem;
    flex-wrap: wrap;
  }

  #section-{{ section.id }} .mt-announce-bar__item {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    white-space: nowrap;
  }

  #section-{{ section.id }} .mt-announce-bar__icon {
    width: 1.8rem;
    height: 1.8rem;
    flex: none;
    display: inline-flex;
    color: inherit;
  }

  #section-{{ section.id }} .mt-announce-bar__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #section-{{ section.id }} .mt-announce-bar__text {
    font-family: var(--font-body--family);
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.01em;
    color: inherit;
    text-decoration: none;
  }

  @media screen and (min-width: 990px) {
    #section-{{ section.id }}.mt-announce-bar {
      padding: 1.1rem var(--page-padding, 2rem);
    }

    #section-{{ section.id }} .mt-announce-bar__list {
      flex-wrap: nowrap;
      justify-content: center;
      gap: 3.2rem 5.6rem;
    }

    #section-{{ section.id }} .mt-announce-bar__text {
      font-size: 1.4rem;
    }
  }

  @media screen and (max-width: 749px) {
    #section-{{ section.id }} .mt-announce-bar__list {
      justify-content: flex-start;
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 2rem;
      scrollbar-width: none;
    }

    #section-{{ section.id }} .mt-announce-bar__list::-webkit-scrollbar {
      display: none;
    }

    #section-{{ section.id }} .mt-announce-bar__text {
      font-size: 1.25rem;
    }
  }
</style>

{% schema %}
{
  "name": "Martilness announce bar",
  "tag": "section",
  "class": "section-mt-announce-bar",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#09412d"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "dolly", "label": "Dolly" },
            { "value": "return", "label": "Return" },
            { "value": "star", "label": "Star" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Altid GRATIS fragt"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Martilness announce bar",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "text": "Altid GRATIS fragt" } },
        { "type": "item", "settings": { "icon": "dolly", "text": "1-3 dages levering" } },
        { "type": "item", "settings": { "icon": "return", "text": "30 dages tilfredsgaranti" } },
        { "type": "item", "settings": { "icon": "star", "text": "4,8 ud af 5 stjerner på Trustpilot" } }
      ]
    }
  ]
}
{% endschema %}
