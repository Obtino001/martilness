{%- style -%}
  .iwao-trust-bar-{{ section.id }} {
    width: 100%;
    min-height: 38px;
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    overflow: hidden;
    border-bottom: 1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.08 }};
    font-family: inherit;
    position: relative;
    z-index: 2;
    box-sizing: border-box;
  }

  .iwao-trust-bar-{{ section.id }} *,
  .iwao-trust-bar-{{ section.id }} *::before,
  .iwao-trust-bar-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__inner {
    width: 100%;
    min-height: 38px;
    padding: 0 48px;
    display: flex;
    align-items: center;
  }

  .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__desktop {
    width: 100%;
    max-width: 1480px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: center;
    white-space: nowrap;
  }

  .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__item-wrap {
    display: flex;
    align-items: center;
  }

  .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__item-wrap:nth-child(1) {
    justify-self: start;
  }

  .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__item-wrap:nth-child(2) {
    justify-self: center;
  }

  .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__item-wrap:nth-child(3) {
    justify-self: center;
  }

  .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__item-wrap:nth-child(n+4) {
    justify-self: end;
  }

  .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__item,
  .iwao-trust-bar-{{ section.id }} a.iwao-trust-bar__phone,
  .iwao-trust-bar-{{ section.id }} a.iwao-trust-bar__phone:link,
  .iwao-trust-bar-{{ section.id }} a.iwao-trust-bar__phone:visited {
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: {{ section.settings.text_color | color_modify: 'alpha', 0.94 }} !important;
    font-size: 15px;
    line-height: 1;
    font-weight: 500;
    letter-spacing: 0.005em;
    text-decoration: none;
  }

  .iwao-trust-bar-{{ section.id }} a.iwao-trust-bar__item:hover,
  .iwao-trust-bar-{{ section.id }} a.iwao-trust-bar__phone:hover {
    color: {{ section.settings.text_color }} !important;
    text-decoration: none;
  }

  .iwao-trust-bar-{{ section.id }} a.iwao-trust-bar__phone {
    font-weight: 600;
    flex: 0 0 auto;
  }

  .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__icon,
  .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__icon svg {
    width: 19px;
    height: 19px;
    flex: 0 0 19px;
    color: {{ section.settings.icon_color }};
    display: block;
  }

  .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__divider {
    width: 1px;
    height: 22px;
    margin: 0 30px;
    background: {{ section.settings.text_color | color_modify: 'alpha', 0.22 }};
    flex: 0 0 1px;
  }

  .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__mobile { display: none; }

  @media (max-width: 1280px) {
    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__inner { padding: 0 32px; }
    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__divider { margin: 0 20px; }
    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__item,
    .iwao-trust-bar-{{ section.id }} a.iwao-trust-bar__phone { font-size: 14px; gap: 8px; }
  }

  @media (max-width: 1180px) {
    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__inner { padding: 0 24px; }
    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__divider { margin: 0 14px; }
    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__item,
    .iwao-trust-bar-{{ section.id }} a.iwao-trust-bar__phone { font-size: 13px; gap: 7px; }
    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__icon { width: 16px; height: 16px; flex-basis: 16px; }
  }

  @media (max-width: 989px) {
    .iwao-trust-bar-{{ section.id }} { min-height: 36px; }
    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__inner {
      min-height: 36px;
      padding: 0;
      justify-content: flex-start;
    }
    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__desktop { display: none; }

    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__mobile {
      width: 100%;
      min-height: 36px;
      display: flex;
      align-items: center;
      position: relative;
      background: {{ section.settings.bg_color }};
    }

    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__ticker {
      position: relative;
      min-width: 0;
      flex: 1 1 auto;
      height: 36px;
      overflow: hidden;
      display: flex;
      align-items: center;
      padding-left: 12px;
    }

    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__ticker::after {
      content: "";
      position: absolute;
      top: 0; right: 0;
      width: 44px; height: 100%;
      pointer-events: none;
      background: linear-gradient(to right, {{ section.settings.bg_color | color_modify: 'alpha', 0 }}, {{ section.settings.bg_color }});
      z-index: 2;
    }

    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__track {
      display: flex;
      align-items: center;
      width: max-content;
      will-change: transform;
      animation: iwaoTrustBarTicker {{ section.settings.marquee_speed }}s linear infinite;
    }

    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__group {
      display: flex;
      align-items: center;
      flex: 0 0 auto;
      white-space: nowrap;
    }

    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__mobile .iwao-trust-bar__item {
      min-height: 36px;
      font-size: 12.5px;
      line-height: 1;
      font-weight: 500;
      gap: 7px;
      color: {{ section.settings.text_color | color_modify: 'alpha', 0.92 }};
    }

    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__mobile .iwao-trust-bar__icon,
    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__mobile .iwao-trust-bar__icon svg {
      width: 15px; height: 15px; flex-basis: 15px;
    }

    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__mobile .iwao-trust-bar__divider {
      height: 14px;
      margin: 0 16px;
      background: {{ section.settings.text_color | color_modify: 'alpha', 0.16 }};
    }

    .iwao-trust-bar-{{ section.id }} a.iwao-trust-bar__mobile-phone,
    .iwao-trust-bar-{{ section.id }} a.iwao-trust-bar__mobile-phone:link,
    .iwao-trust-bar-{{ section.id }} a.iwao-trust-bar__mobile-phone:visited {
      height: 36px;
      flex: 0 0 auto;
      min-width: 116px;
      padding: 0 10px;
      margin-left: 4px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      color: {{ section.settings.text_color }} !important;
      text-decoration: none;
      font-size: 13px;
      line-height: 1;
      font-weight: 600;
      white-space: nowrap;
      background: {{ section.settings.bg_color }};
      border-left: 1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.16 }};
      position: relative;
      z-index: 3;
    }

    .iwao-trust-bar-{{ section.id }} a.iwao-trust-bar__mobile-phone:hover { 
      color: {{ section.settings.text_color }} !important; 
      text-decoration: none; 
    }

    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__mobile-phone svg {
      width: 15px; height: 15px; flex: 0 0 15px;
      color: {{ section.settings.icon_color }};
      display: block;
    }

    @keyframes iwaoTrustBarTicker {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }
  }

  @media (max-width: 374px) {
    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__mobile-phone {
      min-width: 104px;
      font-size: 12px;
      padding: 0 8px;
    }
    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__mobile .iwao-trust-bar__item { font-size: 12px; }
    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__mobile .iwao-trust-bar__divider { margin: 0 13px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .iwao-trust-bar-{{ section.id }} .iwao-trust-bar__track { animation: none; }
  }
{%- endstyle -%}

<div class="iwao-trust-bar-{{ section.id }}" data-iwao-trust-bar="">
  <div class="iwao-trust-bar__inner">
    {%- liquid
      assign right_id = blank
      for block in section.blocks
        assign text_down = block.settings.text | downcase
        if block.settings.position == 'right' or text_down contains 'trustpilot'
          assign right_id = block.id
        endif
      endfor
      if right_id == blank and section.blocks.size > 1
        for block in section.blocks
          if forloop.last
            assign right_id = block.id
          endif
        endfor
      endif
    -%}

    <!-- DESKTOP -->
    <div class="iwao-trust-bar__desktop">
      {%- if section.settings.phone_text != blank -%}
        <div class="iwao-trust-bar__item-wrap">
          <a class="iwao-trust-bar__phone" href="{{ section.settings.phone_url }}" aria-label="{{ section.settings.phone_text }}">
            <div class="iwao-trust-bar__icon">{{ section.settings.phone_icon }}</div>
            <span>{{ section.settings.phone_text }}</span>
          </a>
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        <div class="iwao-trust-bar__item-wrap">
          {%- if block.settings.link != blank -%}
            <a class="iwao-trust-bar__item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
              <div class="iwao-trust-bar__icon">{{ block.settings.icon }}</div>
              <span>{{ block.settings.text }}</span>
            </a>
          {%- else -%}
            <span class="iwao-trust-bar__item" {{ block.shopify_attributes }}>
              <div class="iwao-trust-bar__icon">{{ block.settings.icon }}</div>
              <span>{{ block.settings.text }}</span>
            </span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <!-- MOBILE -->
    <div class="iwao-trust-bar__mobile">
      <div class="iwao-trust-bar__ticker">
        <div class="iwao-trust-bar__track">
          {%- for i in (1..2) -%} <!-- Looped twice for infinite marquee effect -->
            <div class="iwao-trust-bar__group">
              {%- for block in section.blocks -%}
                {%- if block.settings.link != blank -%}
                  <a class="iwao-trust-bar__item" href="{{ block.settings.link }}">
                    <div class="iwao-trust-bar__icon">
                      {{ block.settings.icon }}
                    </div>
                    <span>{{ block.settings.text }}</span>
                  </a>
                {%- else -%}
                  <span class="iwao-trust-bar__item">
                    <div class="iwao-trust-bar__icon">
                      {{ block.settings.icon }}
                    </div>
                    <span>{{ block.settings.text }}</span>
                  </span>
                {%- endif -%}
                <span class="iwao-trust-bar__divider" aria-hidden="true"></span>
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
      
      {%- if section.settings.phone_text != blank -%}
        <a class="iwao-trust-bar__mobile-phone" href="{{ section.settings.phone_url }}" aria-label="{{ section.settings.phone_text }}">
          <div class="iwao-trust-bar__icon">
            {{ section.settings.phone_icon }}
          </div>
          <span>{{ section.settings.phone_text }}</span>
        </a>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Trust Announcement Bar",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#242833"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#d8a94f"
    },
    {
      "type": "header",
      "content": "Phone Details"
    },
    {
      "type": "text",
      "id": "phone_text",
      "label": "Phone Number Text"
    },
    {
      "type": "url",
      "id": "phone_url",
      "label": "Phone Number Link",
      "info": "Use tel:+4570707130 format"
    },
    {
      "type": "html",
      "id": "phone_icon",
      "label": "Phone Icon (SVG)"
    },
    {
      "type": "header",
      "content": "Mobile Settings"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Marquee Speed",
      "default": 22
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "Trust Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Trust feature"
        },
        {
          "type": "html",
          "id": "icon",
          "label": "Icon (SVG)",
          "info": "Paste the raw SVG code here"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Optional)"
        },
        {
          "type": "select",
          "id": "position",
          "label": "Desktop Position",
          "options": [
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Announcement Bar",
      "blocks": [
        {
          "type": "usp",
          "settings": {
            "text": "Altid GRATIS fragt",
            "position": "center"
          }
        },
        {
          "type": "usp",
          "settings": {
            "text": "1-3 dages levering",
            "position": "center"
          }
        },
        {
          "type": "usp",
          "settings": {
            "text": "30 dages tilfredsgaranti",
            "position": "center"
          }
        },
        {
          "type": "usp",
          "settings": {
            "text": "4,8 ud af 5 stjerner på Trustpilot",
            "position": "right"
          }
        }
      ]
    }
  ]
}
{% endschema %}