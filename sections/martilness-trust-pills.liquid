{%- liquid
  assign accent = section.settings.accent_color | default: '#5c1a1a'
-%}

<div
  id="section-{{ section.id }}"
  class="mt-trust-pills color-{{ section.settings.color_scheme }}"
  style="
    --mt-pill-accent: {{ accent }};
    --mt-pill-pad-top: {{ section.settings.padding_top }}px;
    --mt-pill-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="mt-trust-pills__inner page-width">
    <ul class="mt-trust-pills__list" role="list">
      {% for block in section.blocks %}
        {% if block.settings.label != blank %}
          <li class="mt-trust-pills__item" {{ block.shopify_attributes }}>
            <span class="mt-trust-pills__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" focusable="false">
                <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="mt-trust-pills__label">{{ block.settings.label }}</span>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</div>

<style>
  #section-{{ section.id }}.mt-trust-pills {
    padding: var(--mt-pill-pad-top) 0 var(--mt-pill-pad-bottom);
    background: rgb(var(--color-background));
  }

  #section-{{ section.id }} .mt-trust-pills__inner {
    max-width: var(--page-width, 120rem);
    margin: 0 auto;
    padding-inline: var(--page-padding, 2rem);
  }

  #section-{{ section.id }} .mt-trust-pills__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.2rem 1.6rem;
  }

  #section-{{ section.id }} .mt-trust-pills__item {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 1.6rem 0.85rem 1rem;
    border: 1.5px solid var(--mt-pill-accent);
    border-radius: 9999px;
    background: #fff;
    color: var(--mt-pill-accent);
    white-space: nowrap;
  }

  #section-{{ section.id }} .mt-trust-pills__icon {
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--mt-pill-accent);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  #section-{{ section.id }} .mt-trust-pills__icon svg {
    width: 1.25rem;
    height: 1.25rem;
    display: block;
  }

  #section-{{ section.id }} .mt-trust-pills__label {
    font-family: var(--font-body--family);
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.01em;
  }

  @media (max-width: 749px) {
    #section-{{ section.id }} .mt-trust-pills__list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      align-items: stretch;
    }

    #section-{{ section.id }} .mt-trust-pills__item {
      justify-content: flex-start;
      white-space: normal;
      width: 100%;
      min-width: 0;
      padding: 0.75rem 1rem 0.75rem 0.75rem;
      gap: 0.7rem;
    }

    #section-{{ section.id }} .mt-trust-pills__icon {
      width: 2rem;
      height: 2rem;
    }

    #section-{{ section.id }} .mt-trust-pills__icon svg {
      width: 1.1rem;
      height: 1.1rem;
    }

    #section-{{ section.id }} .mt-trust-pills__label {
      font-size: 1.2rem;
      line-height: 1.25;
    }
  }
</style>

{% schema %}
{
  "name": "Trust pills",
  "tag": "section",
  "class": "section-martilness-trust-pills",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#5c1a1a"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Pill",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "1-3 Hverdages Levering"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust pills",
      "blocks": [
        { "type": "pill", "settings": { "label": "1-3 Hverdages Levering" } },
        { "type": "pill", "settings": { "label": "Kundeservice 24/7" } },
        { "type": "pill", "settings": { "label": "Nem & Sikker Betaling" } },
        { "type": "pill", "settings": { "label": "Fri Fragt Over 500kr" } }
      ]
    }
  ]
}
{% endschema %}
